<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>ZSP_Flare_Dispenser</SubtypeId>
			</Id>
			<DisplayName>Flare Dispenser</DisplayName>
			<Description>
			>Capacity: 28
			>RPM: 300
			Decoy flare is an aerial infrared countermeasure to counter an infrared homing ("heat-seeking") surface-to-air missile or air-to-air missile.</Description>
			<Icon>Textures\GUI\Icons\Cubes\Flare Dispenser.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\small\Flares\Flare Dispenser.mwm</Model>
			<Components>
                <Component Subtype="InteriorPlate" Count="1" />
                <Component Subtype="Construction" Count="2" />
                <Component Subtype="MetalGrid" Count="1" />
                <Component Subtype="SmallTube" Count="1" />
                <Component Subtype="Motor" Count="1" />
                <Component Subtype="Computer" Count="1" />
                <Component Subtype="InteriorPlate" Count="1" />
            </Components>
            <CriticalComponent Subtype="Computer" Index="0" />
			<BlockPairName>Flare Dispenser</BlockPairName>
			<MirroringY>Z</MirroringY>
            <MirroringZ>Y</MirroringZ>
			<ResourceSinkGroup>Defense</ResourceSinkGroup>
			<InventoryMaxVolume>0.1</InventoryMaxVolume>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>25</PCU>
			<BuildTimeSeconds>5</BuildTimeSeconds>
			<TargetingGroups>
				<string>Weapons</string>
			</TargetingGroups>
			<IsAirTight>true</IsAirTight>
			<BlockVariants>
				<BlockVariant>
					<TypeId>ConveyorSorter</TypeId>
					<SubtypeId>ZSP_Flare_Dispenser</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>ConveyorSorter</TypeId>
					<SubtypeId>ZSP_Flare_Dispenser_Slim</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>ConveyorSorter</TypeId>
					<SubtypeId>ZSP_Flare_Dispenser_Stealth</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>ConveyorSorter</TypeId>
					<SubtypeId>ZSP_Flare_Dispenser_Slim_Stealth</SubtypeId>
				</BlockVariant>
			</BlockVariants>
		</Definition>
		
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>ZSP_Flare_Dispenser_Slim</SubtypeId>
			</Id>
			<DisplayName>Slim Flare Dispenser</DisplayName>
			<Description>
			>Capacity: 28
			>RPM: 300
			Decoy flare is an aerial infrared countermeasure to counter an infrared homing ("heat-seeking") surface-to-air missile or air-to-air missile.</Description>
			<Icon>Textures\GUI\Icons\Cubes\Flare_Dispenser_Slim.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\small\Flares\Flare_Dispenser_Slim.mwm</Model>
			<Components>
                <Component Subtype="InteriorPlate" Count="1" />
                <Component Subtype="Construction" Count="2" />
                <Component Subtype="MetalGrid" Count="1" />
                <Component Subtype="SmallTube" Count="1" />
                <Component Subtype="Motor" Count="1" />
                <Component Subtype="Computer" Count="1" />
                <Component Subtype="InteriorPlate" Count="1" />
            </Components>
            <CriticalComponent Subtype="Computer" Index="0" />
			<BlockPairName>Slim Flare Dispenser</BlockPairName>
			<BuildTimeSeconds>5</BuildTimeSeconds>
			<MirroringY>Z</MirroringY>
            <MirroringZ>Y</MirroringZ>
			<ResourceSinkGroup>Defense</ResourceSinkGroup>
			<InventoryMaxVolume>0.1</InventoryMaxVolume>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>25</PCU>
			<TargetingGroups>
				<string>Weapons</string>
			</TargetingGroups>
			<IsAirTight>true</IsAirTight>
		</Definition>
	</CubeBlocks>
</Definitions>