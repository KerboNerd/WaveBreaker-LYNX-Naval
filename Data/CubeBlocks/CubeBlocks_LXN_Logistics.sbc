<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    <!-- >>>>>> ADVANCED ASSEMBLY PLANT 1 <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<< -->
    <Definition xsi:type="MyObjectBuilder_AssemblerDefinition">
      <Id>
        <TypeId>Assembler</TypeId>
        <SubtypeId>LXN_AdvancedAssemblyPlant_01</SubtypeId>
      </Id>
      <DisplayName>Advanced Assembly Plant "OmniFab Fabricator XL"</DisplayName>
      <Icon>Textures\Icons\LXN_AdvancedAssemblyPlant_01.dds</Icon>
      <Description>The Advanced Assembly Plant is a state-of-the-art facility designed for efficient
        production of a wide variety of components and parts. Equipped with cutting-edge technology
        and machinery, it streamlines the assembly process, ensuring reliable and rapid
        manufacturing to meet the demands of any engineering project. Power Consumption: 5MW</Description>
      <CubeSize>Large</CubeSize>
      <GuiVisible>false</GuiVisible>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="5" y="5" z="9" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Large\LXN_AdvancedAssemblyPlant_01.mwm</Model>
      <UseModelIntersection>true</UseModelIntersection>
      <Components>
        <Component Subtype="Construction" Count="250" />
        <Component Subtype="InteriorPlate" Count="500" />
        <Component Subtype="SteelPlate" Count="1500" />
        <Component Subtype="MetalGrid" Count="100" />
        <Component Subtype="SmallTube" Count="150" />
        <Component Subtype="LargeTube" Count="60" />
        <Component Subtype="Motor" Count="40" />
        <Component Subtype="Display" Count="10" />
        <Component Subtype="Computer" Count="50" />
        <Component Subtype="Thrust" Count="100" />
      </Components>
      <CriticalComponent Subtype="SteelPlate" Index="0" />
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33"
          File="Models\Large\LXN_AdvancedAssemblyPlant_01_BS1.mwm" />
        <Model BuildPercentUpperBound="0.67"
          File="Models\Large\LXN_AdvancedAssemblyPlant_01_BS2.mwm" />
        <Model BuildPercentUpperBound="1.00"
          File="Models\Large\LXN_AdvancedAssemblyPlant_01_BS3.mwm" />
      </BuildProgressModels>
      <BlockPairName>LXN_AdvancedAssemblyPlant_01</BlockPairName>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>100</BuildTimeSeconds>
      <ResourceSinkGroup>Factory</ResourceSinkGroup>
      <InventoryMaxVolume>16</InventoryMaxVolume>
      <InventorySize>
        <X>4</X>
        <Y>4</Y>
        <Z>4</Z>
      </InventorySize>
      <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
      <OperationalPowerConsumption>5</OperationalPowerConsumption>
      <BlueprintClasses>
        <Class>LargeBlocks</Class>
        <Class>SmallBlocks</Class>
        <Class>Components</Class>
        <Class>EliteEquipment</Class>
        <Class>EliteTools</Class>
        <Class>EliteWeapons</Class>
        <Class>EliteConsumables</Class>
        <Class>BuildPlanner</Class>
      </BlueprintClasses>
      <AssemblySpeed>17</AssemblySpeed>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <PrimarySound>BlockAssembler</PrimarySound>
      <ActionSound>BlockAssemblerProcess</ActionSound>
      <DestroyEffect>Explosion_Missile</DestroyEffect>
      <DestroySound>WepSmallMissileExpl</DestroySound>
      <PCU>200</PCU>
      <IsAirTight>false</IsAirTight>
      <TieredUpdateTimes>
        <unsignedInt>60</unsignedInt>
        <unsignedInt>120</unsignedInt>
        <unsignedInt>240</unsignedInt>
      </TieredUpdateTimes>
    </Definition>

    <!-- >>>>>> ADVANCED REFINING PLANT 1 <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<< -->
    <Definition xsi:type="MyObjectBuilder_RefineryDefinition">
      <Id>
        <TypeId>Refinery</TypeId>
        <SubtypeId>LXN_AdvancedRefiningPlant_01</SubtypeId>
      </Id>
      <DisplayName>Advanced Refining Plant "OmniFab Melter XL"</DisplayName>
      <Icon>Textures\Icons\LXN_AdvancedRefiningPlant_01.dds</Icon>
      <Description>high-performance refining facility designed to expertly process ores into ingots
        with exceptional speed and efficiency. Combining cutting-edge technology with robust
        construction, the OmniFab Melter XL delivers superior refining capabilities that meet the
        demands of the most challenging projects, ensuring a steady supply of high-quality ingots
        for all your construction needs. Power Consumption: 5MW</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="5" y="7" z="5" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Large\LXN_AdvancedRefiningPlant_01.mwm</Model>
      <UseModelIntersection>true</UseModelIntersection>
      <Components>
        <Component Subtype="Construction" Count="200" />
        <Component Subtype="InteriorPlate" Count="400" />
        <Component Subtype="SteelPlate" Count="1800" />
        <Component Subtype="MetalGrid" Count="120" />
        <Component Subtype="SmallTube" Count="120" />
        <Component Subtype="LargeTube" Count="80" />
        <Component Subtype="Motor" Count="35" />
        <Component Subtype="Display" Count="8" />
        <Component Subtype="Computer" Count="40" />
        <Component Subtype="Thrust" Count="100" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33"
          File="Models\Large\LXN_AdvancedRefiningPlant_01_BS1.mwm" />
        <Model BuildPercentUpperBound="0.67"
          File="Models\Large\LXN_AdvancedRefiningPlant_01_BS2.mwm" />
        <Model BuildPercentUpperBound="1.00"
          File="Models\Large\LXN_AdvancedRefiningPlant_01_BS3.mwm" />
      </BuildProgressModels>
      <BlockPairName>LXN_AdvancedRefiningPlant_01</BlockPairName>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>100</BuildTimeSeconds>
      <ResourceSinkGroup>Factory</ResourceSinkGroup>
      <InventoryMaxVolume>15</InventoryMaxVolume>
      <InventorySize>
        <X>2.5</X>
        <Y>2.5</Y>
        <Z>2.5</Z>
      </InventorySize>
      <InventoryFillFactorMin>0.6</InventoryFillFactorMin>
      <InventoryFillFactorMax>1.2</InventoryFillFactorMax>
      <StandbyPowerConsumption>0.001</StandbyPowerConsumption>
      <OperationalPowerConsumption>5</OperationalPowerConsumption>
      <BlueprintClasses>
        <Class>Ingots</Class>
      </BlueprintClasses>
      <RefineSpeed>1.8</RefineSpeed>
      <MaterialEfficiency>3.0</MaterialEfficiency>
      <OreAmountPerPullRequest>4000</OreAmountPerPullRequest>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <PrimarySound>BlockRafinery</PrimarySound>
      <ActionSound>BlockRafineryProcess</ActionSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>180</PCU>
      <TieredUpdateTimes>
        <unsignedInt>60</unsignedInt>
        <unsignedInt>120</unsignedInt>
        <unsignedInt>240</unsignedInt>
      </TieredUpdateTimes>
    </Definition>

  </CubeBlocks>
</Definitions>