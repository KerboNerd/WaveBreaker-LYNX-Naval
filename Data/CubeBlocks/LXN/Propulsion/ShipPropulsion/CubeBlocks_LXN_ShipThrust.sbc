<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ThrustDefinition">
			<Id>
				<TypeId>Thrust</TypeId>
				<SubtypeId>LXN_VectorProp_01</SubtypeId>
			</Id>
			<DisplayName>AquaMotive 5500VCT (800t Thrust)</DisplayName>
			<Description>L.Y.N.X Industries Subsidiary "AquaMotive" gives you - the 5500VCT! With its advanced
				technology and sleek design, the 5500VCT generates an impressive 800
				tons of thrust, providing incredible speed and maneuverability in aquatic environments.
				
				Power Draw: 50MW
			</Description>
			<Icon>Textures\Icons\LXN_VectorProp_01.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="3" y="3" z="4" />
			<ModelOffset x="0" y="0" z="0" />
			<Model>Models\Small\LXN_VectorProp_01.mwm</Model>
			<ThrusterType>Atmospheric</ThrusterType>
			<SilenceableByShipSoundSystem>true</SilenceableByShipSoundSystem>
			<Components>
				<Component Subtype="SteelPlate" Count="450" />
				<Component Subtype="Construction" Count="125" />
				<Component Subtype="LargeTube" Count="80" />
				<Component Subtype="MetalGrid" Count="50" />
				<Component Subtype="Motor" Count="210" />
				<Component Subtype="Construction" Count="40" />
				<Component Subtype="SteelPlate" Count="100" />
			</Components>
			<CriticalComponent Subtype="Motor" Index="0" />
			<MountPoints>
				<MountPoint Side="Top" StartX="1.05" StartY="1.00" EndX="1.95" EndY="3.00"/>
			</MountPoints>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Small\LXN_VectorProp_01_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\Small\LXN_VectorProp_01_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Small\LXN_VectorProp_01_BS3.mwm"/>
			</BuildProgressModels>
			<UseModelIntersection>true</UseModelIntersection>
			<BlockPairName>LXN_VectorProp_01</BlockPairName>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
			<EdgeType>Light</EdgeType>
			<BuildTimeSeconds>10</BuildTimeSeconds>
			<ResourceSinkGroup>Thrust</ResourceSinkGroup>
			<ForceMagnitude>8064000</ForceMagnitude>
			<MaxPowerConsumption>50</MaxPowerConsumption>
			<MinPowerConsumption>0.000000001</MinPowerConsumption>
			<SlowdownFactor>1</SlowdownFactor>
			<MinPlanetaryInfluence>0.3</MinPlanetaryInfluence>
			<MaxPlanetaryInfluence>1</MaxPlanetaryInfluence>
			<EffectivenessAtMinInfluence>0</EffectivenessAtMinInfluence>
			<EffectivenessAtMaxInfluence>1</EffectivenessAtMaxInfluence>
			<NeedsAtmosphereForInfluence>true</NeedsAtmosphereForInfluence>
			<PropellerUsesPropellerSystem>true</PropellerUsesPropellerSystem>
			<PropellerSubpartEntityName>Propeller</PropellerSubpartEntityName>
			<PropellerRoundsPerSecondOnFullSpeed>1.5</PropellerRoundsPerSecondOnFullSpeed>
			<PropellerRoundsPerSecondOnIdleSpeed>0</PropellerRoundsPerSecondOnIdleSpeed>
			<PropellerAccelerationTime>2</PropellerAccelerationTime>
			<PropellerDecelerationTime>3</PropellerDecelerationTime>
			<PropellerMaxVisibleDistance>1000</PropellerMaxVisibleDistance>
			<PrimarySound>LrgShipSmJetAtmo</PrimarySound>
			<DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<Public>true</Public>
			<DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>15</PCU>
			<IsAirTight>false</IsAirTight>
			<TieredUpdateTimes>
				<unsignedInt>100</unsignedInt>
				<unsignedInt>3600</unsignedInt>
				<unsignedInt>0</unsignedInt>
			</TieredUpdateTimes>
		</Definition>
	</CubeBlocks>
</Definitions>