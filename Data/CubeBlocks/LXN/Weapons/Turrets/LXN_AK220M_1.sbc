<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>LXN_AK220M_1</SubtypeId>
			</Id>
			<DisplayName>AK-220M NAVAL GUN</DisplayName>
			<Description>
				The AK-220M is a next-generation Russian 220mm naval gun system, designed for modern surface combatants and coastal defense.
				This formidable artillery piece features a fully automated loading system and advanced digital fire control, enabling rapid, precise engagement of enemy ships, shore targets, and aerial threats.
				The AK-220M delivers overwhelming firepower with high-explosive shells, offering extended range and devastating impact.
				Equipped with stabilization and all-weather targeting, it maintains accuracy in harsh maritime conditions.
				Max engagement range: 8000m
				Rate of Fire: 20 rounds/minute
				Ammo: 
				- 220mm HE Magazine
			</Description>
			<Icon>Textures\Icons\AK220M\LXN_AK220M_1.dds</Icon>
			<CubeSize>Large</CubeSize>
			<PlaceDecals>false</PlaceDecals>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="3" y="1" z="3"/>
