				<Component Subtype="LargeTube" Count="6" />
				<Component Subtype="MetalGrid" Count="6" />
				<Component Subtype="Motor" Count="15" />
				<Component Subtype="Computer" Count="25" />
				<Component Subtype="SteelPlate" Count="75" />
			</Components>
			<CriticalComponent Index="0" Subtype="Computer"/>
			<MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
