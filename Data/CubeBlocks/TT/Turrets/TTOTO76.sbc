			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>TTOTO76</SubtypeId>
			</Id>
			<DisplayName>Oto-Melara 76</DisplayName>
			<Description>The OTO Melara 76 mm has been widely exported, 
			and is in use by sixty navies. It was favored over the French 100mm naval gun 
			for the joint French/Italian Horizon-class frigate project and FREMM frigate.

				Max engagement range: 3000m
				Rate of Fire: 120
				Reload Time: 8 Seconds
				Ammo: 76mm Shell
			</Description>
			<Icon>Textures\GUI\Icons\TTOTO76.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="2" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\large\TTOTO76.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="75" />
				<Component Subtype="Construction" Count="80" />
