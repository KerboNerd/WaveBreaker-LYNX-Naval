<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_HydrogenEngineDefinition">
			<Id>
				<TypeId>HydrogenEngine</TypeId>
				<SubtypeId>LXN_JetAPU_01</SubtypeId>
			</Id>
			<DisplayName>Jet Auxiliary Power Unit APU-GS1</DisplayName>
			<Description>
				The APU-GS1 is a versatile Auxiliary Power Unit designed for jet propulsion systems,
				capable of ground and in-flight operation to provide essential power supply for
				starting engines and powering onboard systems without the main engine's operation.
				- Fuel: Hydrogen
				- Max Output: 500 kW
				- Fuel Capacity: 500 L
				- Fuel Consumption: 0.01283 L/s
				- Weight: 2.5 tons
			</Description>
			<Icon>Textures\Icons\APU\LXN_JetAPU_01.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="2"/>
			<ModelOffset x="0" y="0" z="0" />
			<Model>Models\APU\LXN_JetAPU_01.mwm</Model>
			<Components>
				<Component Subtype="InteriorPlate" Count="50" /> <!-- 3 kg * 50 = 150 kg -->
				<Component Subtype="Construction" Count="40" /> <!-- 8 kg * 40 = 320 kg -->
				<Component Subtype="LargeTube" Count="25" /> <!-- 25 kg * 25 = 625 kg -->
				<Component Subtype="Motor" Count="15" /> <!-- 24 kg * 15 = 360 kg -->
				<Component Subtype="Computer" Count="5" /> <!-- 0.2 kg * 5 = 1 kg -->
				<Component Subtype="PowerCell" Count="10" /> <!-- 25 kg * 10 = 250 kg -->
			</Components>
			<CriticalComponent Subtype="PowerCell" Index="0" />
			<MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
				<MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="1.00" EndY="1.00"/>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="2.00" EndY="1.00"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="2.00" EndY="1.00"/>
				<MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="1.00" EndY="2.00"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="1.00" EndY="2.00"/>
			</MountPoints>
			<BlockPairName>LXN_JetAPU_01</BlockPairName>
			<MirroringZ>X</MirroringZ>
			<EdgeType>Light</EdgeType>
			<BuildTimeSeconds>40</BuildTimeSeconds>
			<ResourceSinkGroup>Generators</ResourceSinkGroup>
			<ResourceSourceGroup>Reactors</ResourceSourceGroup>
			<MaxPowerOutput>3</MaxPowerOutput>
			<FuelCapacity>20000</FuelCapacity>
			<IsAirTight>false</IsAirTight>
			<InventorySize>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</InventorySize>
			<FuelInfos>
				<FuelInfo>
					<Id>
						<TypeId>GasProperties</TypeId>
						<SubtypeId>Hydrogen</SubtypeId>
					</Id>
				</FuelInfo>
			</FuelInfos>
			<FuelProductionToCapacityMultiplier>0.01283</FuelProductionToCapacityMultiplier>
			<PrimarySound></PrimarySound>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<AnimationSpeed>190</AnimationSpeed>
			<AnimationSpinUpSpeed>5</AnimationSpinUpSpeed>
			<AnimationSpinDownSpeed>7</AnimationSpinDownSpeed>
			<PCU>25</PCU>
			<TargetingGroups>
				<string>PowerSystems</string>
			</TargetingGroups>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\APU\LXN_JetAPU_01_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\APU\LXN_JetAPU_01_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\APU\LXN_JetAPU_01_BS3.mwm"/>
			</BuildProgressModels>
			<MirroringX>Z</MirroringX>
		</Definition>
	</CubeBlocks>
</Definitions>