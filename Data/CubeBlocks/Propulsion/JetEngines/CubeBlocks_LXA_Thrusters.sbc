<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema">
		<CubeBlocks>
			<!-- GENX8 -->
			<Definition xsi:type="MyObjectBuilder_HydrogenEngineDefinition">
				<Id>
					<TypeId>HydrogenEngine</TypeId>
					<SubtypeId>LXA_GENX8_Generator</SubtypeId>
				</Id>
				<DisplayName>Turbo-Jet GeNX8 Generator (GeNX8)</DisplayName>
				<Description>GeNX8 Generator
					Max Power: 3MW
				Max Input: 10,073L/s</Description>
				<Icon>Textures\Icons\LXA_GENX8.dds</Icon>
				<CubeSize>Small</CubeSize>
				<BlockTopology>TriangleMesh</BlockTopology>
				<Size x="3" y="3" z="3" />
				<ModelOffset x="0" y="0" z="0" />
				<Model>Models\Small\LXA_GENX8.mwm</Model>
				<Components>
					<Component Subtype="InteriorPlate" Count="20" />
					<Component Subtype="Construction" Count="15" />
					<Component Subtype="LargeTube" Count="10" />
					<Component Subtype="SmallTube" Count="6" />
					<Component Subtype="Motor" Count="5" />
					<Component Subtype="Computer" Count="5" />
					<Component Subtype="PowerCell" Count="8" />
					<Component Subtype="Construction" Count="6" />
					<Component Subtype="InteriorPlate" Count="8" />
				</Components>
				<CriticalComponent Subtype="PowerCell" Index="0" />
				<MountPoints>
					<MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00" />
					<MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00" />
					<MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00" />
				</MountPoints>
				<BuildProgressModels>
					<Model BuildPercentUpperBound="0.33" File="Models\Small\LXA_GENX8_BS1.mwm" />
					<Model BuildPercentUpperBound="0.67" File="Models\Small\LXA_GENX8_BS2.mwm" />
					<Model BuildPercentUpperBound="1.00" File="Models\Small\LXA_GENX8_BS3.mwm" />
				</BuildProgressModels>
				<BlockPairName>LXA_GENX8_Generator</BlockPairName>
				<MirroringY>Z</MirroringY>
				<MirroringZ>Y</MirroringZ>
				<EdgeType>Light</EdgeType>
				<BuildTimeSeconds>40</BuildTimeSeconds>
				<ResourceSinkGroup>Generators</ResourceSinkGroup>
				<ResourceSourceGroup>Reactors</ResourceSourceGroup>
				<MaxPowerOutput>1</MaxPowerOutput>
				<FuelCapacity>20000</FuelCapacity>
				<IsAirTight>false</IsAirTight>
				<InventorySize>
					<X>1</X>
					<Y>1</Y>
					<Z>1</Z>
				</InventorySize>
				<FuelInfos>
					<FuelInfo>
						<Id>
							<TypeId>GasProperties</TypeId>
							<SubtypeId>Hydrogen</SubtypeId>
						</Id>
					</FuelInfo>
				</FuelInfos>
				<FuelProductionToCapacityMultiplier>0.10083</FuelProductionToCapacityMultiplier>
				<PrimarySound>LXAOJetEngine</PrimarySound>
				<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
				<DamagedSound>ParticleWeapExpl</DamagedSound>
				<DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
				<DestroySound>WepSmallWarheadExpl</DestroySound>
				<AnimationSpeed>190</AnimationSpeed>
				<AnimationSpinUpSpeed>5</AnimationSpinUpSpeed>
				<AnimationSpinDownSpeed>7</AnimationSpinDownSpeed>
				<PCU>25</PCU>
				<TargetingGroups>
					<string>PowerSystems</string>
				</TargetingGroups>
			</Definition>
			<Definition xsi:type="MyObjectBuilder_AirVentDefinition">
				<Id>
					<TypeId>AirVent</TypeId>
					<SubtypeId>LXA_GENX8_Intake</SubtypeId>
				</Id>
				<DisplayName>Turbo-Jet Intake Medium (GeNX8)</DisplayName>
				<Description>Air vent made for the GeNX8 Generator. Used to take in oxygen for the
					thruster.
					Set to Depressurize when using in conjunction with Turbo-Jet Thruster
				Max Intake: 10,073L/s</Description>
				<Icon>Textures\Icons\LXA_GENX8_Intake.dds</Icon>
				<CubeSize>Small</CubeSize>
				<BlockTopology>TriangleMesh</BlockTopology>
				<Size x="3" y="3" z="3" />
				<ModelOffset x="0" y="0" z="0" />
				<Model>Models\Small\LXA_GENX8_Intake.mwm</Model>
				<Components>
					<Component Subtype="InteriorPlate" Count="50" />
					<Component Subtype="Construction" Count="10" />
					<Component Subtype="Motor" Count="8" />
					<Component Subtype="Computer" Count="5" />
					<Component Subtype="InteriorPlate" Count="10" />
				</Components>
				<CriticalComponent Subtype="Computer" Index="0" />
				<MountPoints>
					<MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00" />
				</MountPoints>
				<BuildProgressModels>
					<Model BuildPercentUpperBound="0.33" File="Models\Small\LXA_GENX8_Intake_BS1.mwm" />
					<Model BuildPercentUpperBound="0.67" File="Models\Small\LXA_GENX8_Intake_BS2.mwm" />
					<Model BuildPercentUpperBound="1.00" File="Models\Small\LXA_GENX8_Intake_BS3.mwm" />
				</BuildProgressModels>
				<BlockPairName>LXA_GENX8_Intake</BlockPairName>
				<EdgeType>Light</EdgeType>
				<BuildTimeSeconds>10</BuildTimeSeconds>
				<ResourceSourceGroup>Battery</ResourceSourceGroup>
				<ResourceSinkGroup>Factory</ResourceSinkGroup>
				<OperationalPowerConsumption>0.75</OperationalPowerConsumption>
				<StandbyPowerConsumption>0.75</StandbyPowerConsumption>
				<VentilationCapacityPerSecond>10073.5</VentilationCapacityPerSecond>
				<RotationSpeed>50</RotationSpeed>
				<SpinUpSpeed>2</SpinUpSpeed>
				<SpinDownSpeed>1</SpinDownSpeed>
				<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
				<DamagedSound>ParticleWeapExpl</DamagedSound>
				<PressurizeSound>BlockAirVentExhale</PressurizeSound>
				<DepressurizeSound>BlockAirVentDepressurize</DepressurizeSound>
				<IdleSound>BlockAirVentIdle</IdleSound>
				<EmissiveColorPreset>Extended</EmissiveColorPreset>
				<DestroyEffect>BlockDestroyedExplosion_Tiny</DestroyEffect>
				<DestroySound>WepSmallWarheadExpl</DestroySound>
				<PCU>10</PCU>
			</Definition>
			<Definition xsi:type="MyObjectBuilder_ThrustDefinition">
				<Id>
					<TypeId>Thrust</TypeId>
					<SubtypeId>LXA_GENX8_Thruster</SubtypeId>
				</Id>
				<DisplayName>Turbo-Fan Thruster 50t(GeNX8)</DisplayName>
				<Description>Turbo-Fan thruster that requires oxygen input
					Use with Intakes set to depressurize
					Oxygen input: 10,073L/s
				Max Thrust: 50 tons</Description>
				<Icon>Textures\Icons\LXA_GENX8_Thruster.dds</Icon>
				<CubeSize>Small</CubeSize>
				<BlockTopology>TriangleMesh</BlockTopology>
				<Size x="3" y="3" z="3" />
				<ModelOffset x="0" y="0" z="0" />
				<Model>Models\Small\LXA_GENX8_Thruster.mwm</Model>
				<Components>
					<Component Subtype="InteriorPlate" Count="15" />
					<Component Subtype="Construction" Count="15" />
					<Component Subtype="MetalGrid" Count="20" />
					<Component Subtype="LargeTube" Count="15" />
					<Component Subtype="Construction" Count="15" />
					<Component Subtype="InteriorPlate" Count="10" />
				</Components>
				<CriticalComponent Subtype="LargeTube" Index="0" />
				<MountPoints>
					<MountPoint Side="Back" StartX="0.10" StartY="0.10" EndX="2.90" EndY="2.90" />
				</MountPoints>
				<BuildProgressModels>
					<Model BuildPercentUpperBound="0.33" File="Models\Small\LXA_GENX8_Thruster_BS1.mwm" />
					<Model BuildPercentUpperBound="0.67" File="Models\Small\LXA_GENX8_Thruster_BS2.mwm" />
					<Model BuildPercentUpperBound="1.00" File="Models\Small\LXA_GENX8_Thruster_BS3.mwm" />
				</BuildProgressModels>
				<UseModelIntersection>true</UseModelIntersection>
				<BlockPairName>LXA_GENX8_Thruster</BlockPairName>
				<EdgeType>Light</EdgeType>
				<BuildTimeSeconds>10</BuildTimeSeconds>
				<ResourceSinkGroup>Thrust</ResourceSinkGroup>
				<ForceMagnitude>497278</ForceMagnitude>
				<FuelConverter>
					<FuelId>
						<TypeId>GasProperties</TypeId>
						<SubtypeId>Oxygen</SubtypeId>
					</FuelId>
					<Efficiency>1</Efficiency>
				</FuelConverter>
				<MaxPowerConsumption>0.4</MaxPowerConsumption>
				<MinPowerConsumption>0.000000001</MinPowerConsumption>
				<SlowdownFactor>1</SlowdownFactor>
				<MinPlanetaryInfluence>0.1</MinPlanetaryInfluence>
				<MaxPlanetaryInfluence>1</MaxPlanetaryInfluence>
				<EffectivenessAtMinInfluence>1</EffectivenessAtMinInfluence>
				<EffectivenessAtMaxInfluence>0.95</EffectivenessAtMaxInfluence>
				<NeedsAtmosphereForInfluence>true</NeedsAtmosphereForInfluence>
				<FlameDamageLengthScale>0.44</FlameDamageLengthScale>
				<FlameLengthScale>1</FlameLengthScale>
				<FlameIdleColor>
					<X>0.2</X>
					<Y>0.2</Y>
					<Z>0.2</Z>
					<W>-0.9</W>
				</FlameIdleColor>
				<FlameFullColor>
					<X>0.5</X>
					<Y>0.5</Y>
					<Z>0.5</Z>
					<W>0.4</W>
				</FlameFullColor>
				<FlamePointMaterial>CAPJetThrustPoint</FlamePointMaterial>
				<FlameLengthMaterial>CAPJetThrust</FlameLengthMaterial>
				<FlameFlare>LargeGridSmallThruster</FlameFlare>
				<FlameVisibilityDistance>1500</FlameVisibilityDistance>
				<FlameGlareQuerySize>1</FlameGlareQuerySize>
				<PrimarySound>LXAJetThruster</PrimarySound>
				<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
				<DamagedSound>ParticleWeapExpl</DamagedSound>
				<Public>true</Public>
				<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
				<DestroySound>WepSmallWarheadExpl</DestroySound>
				<PCU>15</PCU>
				<IsAirTight>false</IsAirTight>
				<TieredUpdateTimes>
					<unsignedInt>100</unsignedInt>
					<unsignedInt>3600</unsignedInt>
					<unsignedInt>0</unsignedInt>
				</TieredUpdateTimes>
				<TargetingGroups>
					<string>Propulsion</string>
				</TargetingGroups>
			</Definition>
