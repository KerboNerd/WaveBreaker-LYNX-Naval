<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ThrustDefinition">
			<Id>
				<TypeId>Thrust</TypeId>
				<SubtypeId>LXN_IndustrialJet_Thruster</SubtypeId>
			</Id>
			<DisplayName>Solovyev NX-Industra Turbofan Thruster</DisplayName>
			<Description>Solovyev NX-Industra Turbofan Thruster designed for optimal performance with oxygen intake.
				Configure Intakes to Depressurize mode for efficient operation.
				Oxygen Intake: 2.000L/s
				Max thrust 40t Dry and 60t Wet
			</Description>
			<Icon>Textures\Icons\Jet Engines\LXN_IndustrialJet_Thruster.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="3" y="3" z="3" />
			<ModelOffset x="0" y="0" z="0" />
			<Model>Models\Propulsion\Jets\LXN_IndustrialJet_Thruster.mwm</Model>
			<Components>
				<Component Subtype="InteriorPlate" Count="16" />
				<Component Subtype="Construction" Count="14" />
				<Component Subtype="LargeTube" Count="5" />
				<Component Subtype="MetalGrid" Count="6" />
				<Component Subtype="Construction" Count="14" />
				<Component Subtype="InteriorPlate" Count="18" />
			</Components>
			<CriticalComponent Subtype="LargeTube" Index="0" />
			<MountPoints>
				<MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00" Default="true"/>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00"/>
				<MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00"/>
			</MountPoints>
			<UseModelIntersection>true</UseModelIntersection>
			<BlockPairName>LXN_IndustrialJet_Thruster</BlockPairName>
			<EdgeType>Light</EdgeType>
			<BuildTimeSeconds>10</BuildTimeSeconds>
			<ResourceSinkGroup>Thrust</ResourceSinkGroup>
			<!-- 30t of Thrust -->
			<ForceMagnitude>294199</ForceMagnitude>
			<FuelConverter>
				<FuelId>
					<TypeId>GasProperties</TypeId>
					<SubtypeId>Oxygen</SubtypeId>
				</FuelId>
				<Efficiency>1</Efficiency>
			</FuelConverter>
			<MaxPowerConsumption>0.6</MaxPowerConsumption>
			<MinPowerConsumption>0.000000001</MinPowerConsumption>
			<SlowdownFactor>1</SlowdownFactor>
			<MinPlanetaryInfluence>0.1</MinPlanetaryInfluence>
			<MaxPlanetaryInfluence>1</MaxPlanetaryInfluence>
			<EffectivenessAtMinInfluence>1</EffectivenessAtMinInfluence>
			<EffectivenessAtMaxInfluence>0.95</EffectivenessAtMaxInfluence>
			<NeedsAtmosphereForInfluence>true</NeedsAtmosphereForInfluence>
			<FlameDamageLengthScale>0.44</FlameDamageLengthScale>
			<FlameLengthScale>1</FlameLengthScale>
			<FlameIdleColor>
				<X>0.2</X>
				<Y>0.2</Y>
				<Z>0.2</Z>
				<W>-0.9</W>
			</FlameIdleColor>
			<FlameFullColor>
				<X>0.5</X>
				<Y>0.5</Y>
				<Z>0.5</Z>
				<W>0.4</W>
			</FlameFullColor>
			<FlamePointMaterial>CAPJetThrustPoint</FlamePointMaterial>
			<FlameLengthMaterial>CAPJetThrust</FlameLengthMaterial>
			<FlameFlare>LargeGridSmallThruster</FlameFlare>
			<FlameVisibilityDistance>1500</FlameVisibilityDistance>
			<FlameGlareQuerySize>1</FlameGlareQuerySize>
			<PrimarySound>LXNAL41Audio</PrimarySound>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<Public>true</Public>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>15</PCU>
			<IsAirTight>false</IsAirTight>
			<TieredUpdateTimes>
				<unsignedInt>100</unsignedInt>
				<unsignedInt>3600</unsignedInt>
				<unsignedInt>0</unsignedInt>
			</TieredUpdateTimes>
			<TargetingGroups>
				<string>Propulsion</string>
			</TargetingGroups>
			<MirroringZ>Y</MirroringZ>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Propulsion\Jets\LXN_IndustrialJet_Thruster_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\Propulsion\Jets\LXN_IndustrialJet_Thruster_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Propulsion\Jets\LXN_IndustrialJet_Thruster_BS3.mwm"/>
			</BuildProgressModels>
			<MirroringY>Z</MirroringY>
		</Definition>
	</CubeBlocks>
</Definitions>