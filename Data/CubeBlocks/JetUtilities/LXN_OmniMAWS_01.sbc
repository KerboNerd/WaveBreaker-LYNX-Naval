<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>LXN_OmniMAWS_01</SubtypeId>
			</Id>
			<DisplayName>Omni-Direction Missile Approach Warning System (MAWS)</DisplayName>
			<Description>
				Defense system used on military aircraft to detect and respond to incoming missiles. It uses sensors to identify the threat of approaching missiles,
				typically by detecting the ultraviolet or infrared signatures emitted by the missile's engine, and then alerts the pilot.
				Scan Range: 15m
			</Description>
			<Icon>Textures\Icons\LXN_OmniMAWS_01.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="2"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Small\LXN_OmniMAWS_01.mwm</Model>
			<Components>
				<Component Subtype="InteriorPlate" Count="1" />
				<Component Subtype="Construction" Count="3" />
				<Component Subtype="Detector" Count="1" />
				<Component Subtype="Motor" Count="2" />
				<Component Subtype="Computer" Count="2" />
				<Component Subtype="InteriorPlate" Count="2" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" />
			<BuildProgressModels>
			</BuildProgressModels>
			<BlockPairName>LXN_OmniMAWS_01</BlockPairName>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
			<VoxelPlacement>
				<!--Possible settings Both,InVoxel,OutsideVoxel,Volumetric. If volumetric set than MaxAllowed and MinAllowed will be used.-->
				<StaticMode>
					<PlacementMode>OutsideVoxel</PlacementMode>
					<MaxAllowed>0.2</MaxAllowed>
					<MinAllowed>0</MinAllowed>
				</StaticMode>
				<DynamicMode>
					<PlacementMode>OutsideVoxel</PlacementMode>
					<MaxAllowed>0.2</MaxAllowed>
					<MinAllowed>0.01</MinAllowed>
				</DynamicMode>
			</VoxelPlacement>
			<EdgeType>Light</EdgeType>
			<BuildTimeSeconds>20</BuildTimeSeconds>
			<OverlayTexture>Textures\GUI\CAPThermal_hud.dds</OverlayTexture>
			<WeaponDefinitionId Subtype="LXN_MAWSWeapon" />
			<InventoryMaxVolume>0.01</InventoryMaxVolume>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<ResourceSinkGroup>Defense</ResourceSinkGroup>
			<MinElevationDegrees>-45</MinElevationDegrees>
			<MaxElevationDegrees>45</MaxElevationDegrees>
			<MinAzimuthDegrees>-45</MinAzimuthDegrees>
			<MaxAzimuthDegrees>45</MaxAzimuthDegrees>
			<RotationSpeed>0.01</RotationSpeed>
			<ElevationSpeed>0.01 </ElevationSpeed>
			<IdleRotation>false</IdleRotation>
			<MaxRangeMeters>4500</MaxRangeMeters>
			<MinFov>0.1</MinFov>
			<MaxFov>1.04719755</MaxFov>
			<EmissiveColorPreset>Default</EmissiveColorPreset>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>225</PCU>
			<AmmoPullAmountPerTick>3</AmmoPullAmountPerTick>
			<InventoryFillFactorMin>.25</InventoryFillFactorMin>
			<InventoryFillFactorMax>.5</InventoryFillFactorMax>
			<TieredUpdateTimes>
				<unsignedInt>10</unsignedInt>
				<unsignedInt>0</unsignedInt>
			</TieredUpdateTimes>
			<TargetingGroups>
				<string>Weapons</string>
			</TargetingGroups>
			<UseModelIntersection>true</UseModelIntersection>
			<MountPoints>
				<MountPoint Side="Back" StartX="0.00" StartY="0.02" EndX="1.00" EndY="0.48"/>
				<MountPoint Side="Left" StartX="0.00" StartY="0.02" EndX="2.00" EndY="0.48"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.02" EndX="2.00" EndY="0.48"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="1.00" EndY="2.00"/>
			</MountPoints>
		</Definition>
	</CubeBlocks>
</Definitions>