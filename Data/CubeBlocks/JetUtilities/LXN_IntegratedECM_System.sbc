<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>LXN_IntegratedECM_System</SubtypeId>
			</Id>
			<DisplayName>L-660LX-17Q Integrated (ECM) System</DisplayName>
			<Description>Sophisticated Integrated ECM System designed to disrupt enemy radar and communications, providing protection for the aircraft carrying it.
				1MW Passive Power Draw
				3,000m max range
			</Description>
			<Icon>Textures\GUI\Icons\Cubes\LXN_IntegratedECM_System.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="4" z="3"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Small\LXN_IntegratedECM_System.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="2" />
				<Component Subtype="Construction" Count="3" />
				<Component Subtype="MetalGrid" Count="2" />
				<Component Subtype="LargeTube" Count="1" />
				<Component Subtype="Computer" Count="4" />
				<Component Subtype="SteelPlate" Count="3" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" />
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Small\LXN_IntegratedECM_System_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\Small\LXN_IntegratedECM_System_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Small\LXN_IntegratedECM_System_BS3.mwm"/>
			</BuildProgressModels>
			<BlockPairName>LXN_IntegratedECM_System</BlockPairName>
			<MirroringY>X</MirroringY>
			<Center x="0" y="0" z="0" />
			<BuildTimeSeconds>15</BuildTimeSeconds>
			<EdgeType>Light</EdgeType>
			<WeaponDefinitionId Subtype="LXN_IntegratedECM_SystemMount" />
			<ResourceSinkGroup>Defense</ResourceSinkGroup>
			<InventoryMaxVolume>0.135</InventoryMaxVolume>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>200</PCU>
			<TargetingGroups>
				<string>Weapons</string>
			</TargetingGroups>
			<UseModelIntersection>true</UseModelIntersection>
			<MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="1.00" EndY="4.00"/>
				<MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="1.00" EndY="4.00"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="3.00" EndY="4.00"/>
				<MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="1.00" EndY="3.00"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="1.00" EndY="3.00"/>
			</MountPoints>
			<MirroringX>Y</MirroringX>
		</Definition>
	</CubeBlocks>
</Definitions>