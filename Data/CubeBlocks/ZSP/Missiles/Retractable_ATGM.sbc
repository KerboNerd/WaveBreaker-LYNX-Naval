<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>Retractable_ATGM</SubtypeId>
			</Id>
			<DisplayName>Retractable ATGM</DisplayName>
			<Description>
			>Range: 3500m
			>Speed: 125m/s
			>Requires constant laser designation
			Multi-purpose optical missile system designed to destroy armored vehicles, protected objects and engineering structures, as well as surface targets and enemy personnel.</Description>
			<Icon>Textures\GUI\Icons\Cubes\Retractable_ATGM.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="3"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\small\Retractable ATGM\Retractable_ATGM.mwm</Model>
			<Components>
				<Component Subtype="InteriorPlate" Count="6" />
				<Component Subtype="SmallTube" Count="2" />
				<Component Subtype="Construction" Count="5"/>
				<Component Subtype="Motor" Count="2" />
				<Component Subtype="Computer" Count="2" />
				<Component Subtype="InteriorPlate" Count="4"/>
			</Components>
			<CriticalComponent Subtype="Computer" Index="0"/>
			<BlockPairName>Retractable_ATGM</BlockPairName>
			<IsAirTight>true</IsAirTight>
			<ResourceSinkGroup>Defense</ResourceSinkGroup>
			<InventoryMaxVolume>0.1</InventoryMaxVolume>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>25</PCU>
		</Definition>
	</CubeBlocks>
</Definitions>