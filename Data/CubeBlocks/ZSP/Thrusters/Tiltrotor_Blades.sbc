<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ThrustDefinition">
			<Id>
				<TypeId>Thrust</TypeId>
				<SubtypeId>Tiltrotor_Blades</SubtypeId>
			</Id>
			<DisplayName>Tiltrotor Blades</DisplayName>
			<Description>
				>Thrust: 22 Tonnes
					>Power Consumption Idle: 0.2Mw
		>Power Consumption Operational: 0.75Mw
		Composite high-strength, large-diameter blades designed for use on tiltrotor aircraft.
		</Description>
		<Icon>Textures\GUI\Icons\Cubes\Tiltrotor_Blades.dds</Icon>
		<CubeSize>Small</CubeSize>
		<BlockTopology>TriangleMesh</BlockTopology>
		<Size x="3" y="3" z="2"/>
		<ModelOffset x="0" y="0" z="0"/>
		<Model>Models\Cubes\small\Tiltrotor_Blades.mwm</Model>
		<Components>
			<Component Subtype="InteriorPlate" Count="6"/>
			<Component Subtype="Construction" Count="15"/>
			<Component Subtype="MetalGrid" Count="5"/>
			<Component Subtype="Motor" Count="25"/>
			<Component Subtype="LargeTube" Count="3"/>
			<Component Subtype="SmallTube" Count="2"/>
			<Component Subtype="Construction" Count="15"/>
			<Component Subtype="InteriorPlate" Count="7"/>
		</Components>
		<CriticalComponent Subtype="Motor" Index="0" />
		<BlockPairName>Tiltrotor_Blades</BlockPairName>
		<ResourceSinkGroup>Thrust</ResourceSinkGroup>
		<ForceMagnitude>215000</ForceMagnitude>
		<MaxPowerConsumption>0.075</MaxPowerConsumption>
		<MinPowerConsumption>0.000002</MinPowerConsumption>
		<SlowdownFactor>1</SlowdownFactor>
		<MinPlanetaryInfluence>0.3</MinPlanetaryInfluence>
		<MaxPlanetaryInfluence>1</MaxPlanetaryInfluence>
		<EffectivenessAtMinInfluence>0</EffectivenessAtMinInfluence>
		<EffectivenessAtMaxInfluence>1</EffectivenessAtMaxInfluence>
		<NeedsAtmosphereForInfluence>true</NeedsAtmosphereForInfluence>
		<FlameDamageLengthScale>0</FlameDamageLengthScale>
		<FlameDamage>0</FlameDamage>
		<FlameLengthScale>0</FlameLengthScale>
		<FlameIdleColor>
			<X>0</X>
			<Y>0</Y>
			<Z>0</Z>
			<W>0</W>
		</FlameIdleColor>
		<FlameFullColor>
			<X>0</X>
			<Y>0</Y>
			<Z>0</Z>
			<W>0</W>
		</FlameFullColor>
		<FlamePointMaterial>EngineThrustMiddle</FlamePointMaterial>
		<FlameLengthMaterial>EngineThrustMiddle</FlameLengthMaterial>
		<FlameFlare>LargeGridSmallThruster</FlameFlare>
		<FlameVisibilityDistance>0</FlameVisibilityDistance>
		<FlameGlareQuerySize>0</FlameGlareQuerySize>
		<PropellerUsesPropellerSystem>true</PropellerUsesPropellerSystem>
		<PropellerSubpartEntityName>Blades</PropellerSubpartEntityName>
		<PropellerRoundsPerSecondOnFullSpeed>5</PropellerRoundsPerSecondOnFullSpeed>
		<PropellerRoundsPerSecondOnIdleSpeed>0.1</PropellerRoundsPerSecondOnIdleSpeed>
		<PropellerAccelerationTime>10</PropellerAccelerationTime>
		<PropellerDecelerationTime>2</PropellerDecelerationTime>
		<PropellerMaxVisibleDistance>3000</PropellerMaxVisibleDistance>
		<PrimarySound></PrimarySound>
		<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
		<DamagedSound>ParticleWeapExpl</DamagedSound>
		<Public>true</Public>
		<DestroyEffect>BlockDestroyedExplosion_Tiny</DestroyEffect>
		<DestroySound>WepSmallWarheadExpl</DestroySound>
		<PCU>15</PCU>
		<IsAirTight>true</IsAirTight>
		<TieredUpdateTimes>
			<unsignedInt>100</unsignedInt>
			<unsignedInt>3600</unsignedInt>
			<unsignedInt>0</unsignedInt>
		</TieredUpdateTimes>
		<TargetingGroups>
			<string>Propulsion</string>
		</TargetingGroups>
		<UseModelIntersection>true</UseModelIntersection>
		<BlockVariants>
			<BlockVariant>
				<TypeId>Thrust</TypeId>
				<SubtypeId>Tiltrotor_Blades</SubtypeId>
			</BlockVariant>
			<BlockVariant>
				<TypeId>Thrust</TypeId>
				<SubtypeId>Tiltrotor_Blades_Emissive</SubtypeId>
			</BlockVariant>
		</BlockVariants>
	</Definition>
