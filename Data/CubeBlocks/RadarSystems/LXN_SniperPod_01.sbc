<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema">
		<CubeBlocks>
			<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
				<Id>
					<TypeId>ConveyorSorter</TypeId>
					<SubtypeId>LXN_SniperPod_01</SubtypeId>
				</Id>
				<DisplayName>Sniper Targeting Pod</DisplayName>
				<Description>This highly sophisticated electro-optical/infrared (EO/IR) targeting system, designed for military aircraft, enables precise targeting and identification of Air-To-Ground weaponry from extended standoff ranges.</Description>
				<Icon>Textures\Icons\TargetingSystems\LXN_SniperPod_01.dds</Icon>
				<CubeSize>Small</CubeSize>
				<BlockTopology>TriangleMesh</BlockTopology>
				<Size x="1" y="5" z="1"/>
				<ModelOffset x="0" y="0" z="0"/>
				<Model>Models\TargetingSystems\LXN_SniperPod_01.mwm</Model>
				<Components>
					<Component Subtype="SteelPlate" Count="2" />
					<Component Subtype="Detector" Count="5" />
					<Component Subtype="Computer" Count="5" />
					<Component Subtype="Motor" Count="2" />
					<Component Subtype="Girder" Count="2" />
					<Component Subtype="SteelPlate" Count="2"/>
				</Components>
				<CriticalComponent Subtype="Computer" Index="0" />
				<MountPoints>
					<MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="1.00" EndY="5.00" Default="true"/>
				</MountPoints>
				<BuildProgressModels>
					<Model BuildPercentUpperBound="0.33" File="Models\TargetingSystems\LXN_SniperPod_01_BS1.mwm"/>
					<Model BuildPercentUpperBound="0.67" File="Models\TargetingSystems\LXN_SniperPod_01_BS2.mwm"/>
					<Model BuildPercentUpperBound="1.00" File="Models\TargetingSystems\LXN_SniperPod_01_BS3.mwm"/>
				</BuildProgressModels>
				<BlockPairName>LXN_SniperPod_01</BlockPairName>
				<MirroringY>Z</MirroringY>
				<MirroringZ>Y</MirroringZ>
				<BuildTimeSeconds>8</BuildTimeSeconds>
				<EdgeType>Light</EdgeType>
				<ResourceSinkGroup>Defense</ResourceSinkGroup>
				<InventoryMaxVolume>0.1</InventoryMaxVolume>
				<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
				<DamagedSound>ParticleWeapExpl</DamagedSound>
				<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
				<DestroySound>WepSmallWarheadExpl</DestroySound>
				<PCU>25</PCU>
				<TargetingGroups>
					<string>Weapons</string>
				</TargetingGroups>
				<IsAirTight>false</IsAirTight>
			</Definition>
		</CubeBlocks>
	</Definitions>