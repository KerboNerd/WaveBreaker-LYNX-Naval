<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>LXN_GravestoneRadar_01</SubtypeId>
			</Id>
			<DisplayName>92N6E Gravestone Radar</DisplayName>
			<Description>The 92N6E Gravestone is a state-of-the-art radar system designed for ground-based air defense, capable of identifying, tracking, and engaging a wide range of aerial targets with unparalleled precision.
				Range: 20 km
				Power usage: 850kW
			</Description>
			<Icon>Textures\Icons\TargetingSystems\LXN_GravestoneRadar_01.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="5" y="10" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\TargetingSystems\LXN_GravestoneRadar_01.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="250" />
				<Component Subtype="Construction" Count="50" />
				<Component Subtype="Detector" Count="30" />
				<Component Subtype="RadioCommunication" Count="20" />
				<Component Subtype="SmallTube" Count="20" />
				<Component Subtype="Computer" Count="100" />
				<Component Subtype="SteelPlate" Count="10" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" />
			<MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="5.00" EndY="10.00"/>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="1.00" EndY="10.00"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="1.00" EndY="10.00"/>
				<MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="5.00" EndY="1.00"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="5.00" EndY="1.00" Default="true"/>
			</MountPoints>
			<BlockPairName>LXN_GravestoneRadar_01</BlockPairName>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<ResourceSinkGroup>Defense</ResourceSinkGroup>
			<MaxRangeMeters>20000</MaxRangeMeters>
			<AiEnabled>false</AiEnabled>
			<IdlePower>.10</IdlePower>
			<UsePower>20</UsePower>
			<EmissiveColorPreset>Extended</EmissiveColorPreset>
			<DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>100</PCU>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\TargetingSystems\LXN_GravestoneRadar_01_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\TargetingSystems\LXN_GravestoneRadar_01_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\TargetingSystems\LXN_GravestoneRadar_01_BS3.mwm"/>
			</BuildProgressModels>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
		</Definition>
	</CubeBlocks>
</Definitions>