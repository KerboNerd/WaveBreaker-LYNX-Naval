<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>LXN_SkyShadowPod_pylon</SubtypeId>
			</Id>
			<DisplayName>Sky Shadow Pod (ECM) System</DisplayName>
			<Description>The Sky Shadow is a UK-designed ECM pod used to protect aircraft from enemy missile systems.
				300kW Passive Power Draw
				1,000m max range
			</Description>
			<Icon>Textures\Icons\LXN_SkyShadowPod_pylon.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="6"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Small\LXN_SkyShadowPod_pylon.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="2" />
				<Component Subtype="Construction" Count="3" />
				<Component Subtype="MetalGrid" Count="2" />
				<Component Subtype="LargeTube" Count="1" />
				<Component Subtype="Computer" Count="4" />
				<Component Subtype="SteelPlate" Count="3" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" />
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Small\LXN_SkyShadowPod_pylon_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\Small\LXN_SkyShadowPod_pylon_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Small\LXN_SkyShadowPod_pylon_BS3.mwm"/>
			</BuildProgressModels>
			<BlockPairName>LXN_SkyShadowPod_pylon</BlockPairName>
			<MirroringY>Z</MirroringY>
