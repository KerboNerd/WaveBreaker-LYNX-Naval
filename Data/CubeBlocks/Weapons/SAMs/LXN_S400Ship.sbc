<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>LXN_S400Ship</SubtypeId>
			</Id>
			<DisplayName>S-400 "Triumf" Naval Missile System</DisplayName>
			<Description>The S-400 Naval variant is an advanced ship-launched air defense system designed by Russia's Almaz Central Design Bureau. It effectively neutralizes aerodynamic targets and ballistic threats across extensive ranges.
				Requires ship-mounted Radar for target acquisition.
				20,000m maximum operational range, 500m minimum engagement distance.
			</Description>
			<Icon>Textures\Icons\Weapons\Missiles\LXN_S400Ship.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="3" y="4" z="3"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Weapons\Missiles\LXN_S400Ship.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="800" />
				<Component Subtype="Construction" Count="400" />
				<Component Subtype="SmallTube" Count="100" />
				<Component Subtype="LargeTube" Count="40" />
				<Component Subtype="MetalGrid" Count="200" />
				<Component Subtype="Computer" Count="50" />
				<Component Subtype="LXN_S400MagComp" Count="8" />
			</Components>
			<CriticalComponent Subtype="SteelPlate" Index="0" />
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Weapons\Missiles\LXN_S400Ship_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\Weapons\Missiles\LXN_S400Ship_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Weapons\Missiles\LXN_S400Ship_BS3.mwm"/>
			</BuildProgressModels>
			<BlockPairName>LXN_S400Ship</BlockPairName>
			<!-- <Center x="0" y="0" z="0" /> -->
			<BuildTimeSeconds>15</BuildTimeSeconds>
			<EdgeType>Light</EdgeType>
			<WeaponDefinitionId Subtype="LXN_S400_x4" />
			<ResourceSinkGroup>Defense</ResourceSinkGroup>
			<InventoryMaxVolume>0.135</InventoryMaxVolume>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>425</PCU>
			<TargetingGroups>
				<string>Weapons</string>
			</TargetingGroups>
			<UseModelIntersection>true</UseModelIntersection>
			<MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="2.02" EndX="3.00" EndY="2.98" PressurizedWhenOpen="true"/>
				<MountPoint Side="Back" StartX="0.00" StartY="2.02" EndX="3.00" EndY="2.98" PressurizedWhenOpen="true"/>
				<MountPoint Side="Left" StartX="0.00" StartY="2.02" EndX="3.00" EndY="2.98" PressurizedWhenOpen="true"/>
				<MountPoint Side="Right" StartX="0.00" StartY="2.02" EndX="3.00" EndY="2.98" PressurizedWhenOpen="true"/>
			</MountPoints>
			<MirroringY>Z</MirroringY>
		</Definition>
	</CubeBlocks>
</Definitions>