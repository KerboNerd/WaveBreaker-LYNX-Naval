<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>LXN_FutlyarTorpedo_01</SubtypeId>
			</Id>
			<DisplayName>Futlyar (Fizik-2) Advanced Torpedo System</DisplayName>
			<Description>
				The Futlyar (Fizik-2) represents the pinnacle of Russian torpedo technology, devised for stealthy and lethal underwater engagement. This heavyweight torpedo, designed for versatility, excels in both anti-submarine and anti-surface roles. With a top speed surpassing 60 knots and a range exceeding 50 kilometers, the Futlyar can hunt and engage targets in deep and shallow waters alike.
				It is engineered with state-of-the-art sonar homing, enabling it to detect and lock onto targets with high precision. The torpedo's advanced propulsion system ensures a quiet approach, reducing the chances of detection and countermeasures.
				Requires sophisticated sonar processing for target acquisition and engagement.
				Capable of deep and shallow water operation, ensuring dominance beneath the waves.
				10,000m max range, 1,000m minimum range.
			</Description>
			<Icon>Textures\Icons\LXN_FutlyarTorpedo_01.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="3"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\large\LXN_FutlyarTorpedo_01.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="2500" />
				<Component Subtype="Construction" Count="800" />
				<Component Subtype="SmallTube" Count="200" />
				<Component Subtype="LXN_FutlyarMagComp" Count="1" />
			</Components>
			<CriticalComponent Subtype="SteelPlate" Index="0" />
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Cubes\large\LXN_FutlyarTorpedo_01_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\Cubes\large\LXN_FutlyarTorpedo_01_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Cubes\large\LXN_FutlyarTorpedo_01_BS3.mwm"/>
			</BuildProgressModels>
			<BlockPairName>LXN_FutlyarTorpedo_01</BlockPairName>
			<!-- <Center x="0" y="0" z="0" /> -->
			<BuildTimeSeconds>30</BuildTimeSeconds>
			<EdgeType>Light</EdgeType>
			<WeaponDefinitionId Subtype="LXN_Futlyar" />
			<ResourceSinkGroup>Defense</ResourceSinkGroup>
			<InventoryMaxVolume>0.135</InventoryMaxVolume>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>425</PCU>
			<TargetingGroups>
				<string>Weapons</string>
			</TargetingGroups>
			<UseModelIntersection>true</UseModelIntersection>
			<MountPoints>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="3.00" EndY="1.00"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="3.00" EndY="1.00"/>
				<MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="1.00" EndY="3.00"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="1.00" EndY="3.00"/>
			</MountPoints>
			<MirroringZ>Y</MirroringZ>
			<MirroringY>Z</MirroringY>
		</Definition>
	</CubeBlocks>
</Definitions>