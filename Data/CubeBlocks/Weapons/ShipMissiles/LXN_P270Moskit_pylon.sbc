<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>LXN_P270Moskit_pylon</SubtypeId>
			</Id>
			<DisplayName>P-270 "Moskit" Double Missile Tube</DisplayName>
			<Description>
				The P-270 "Moskit" Double Missile Tube is a state-of-the-art naval weapon system, equipped with two supersonic ramjet-powered Moskit cruise missiles. This formidable system is designed to strike surface vessels with unprecedented speed and accuracy, utilizing the Moskit’s Mach 3 capability at low altitudes. The double tube configuration allows for a rapid salvo, increasing the likelihood of overwhelming enemy defenses.
				Requires a target designation system for precise attacks.
				15km max range, adaptable for various operational scenarios and launch angles.
				15,000m max range, 5,000m minimum range.
			</Description>
			<Icon>Textures\Icons\LXN_P270Moskit_pylon.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="2" z="4"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Large\LXN_P270Moskit_pylon.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="200" />
				<Component Subtype="Computer" Count="24" />
				<Component Subtype="SmallTube" Count="18" />
				<Component Subtype="LargeTube" Count="10" />
				<Component Subtype="MetalGrid" Count="25" />
				<Component Subtype="Construction" Count="30" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" />
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Large\LXN_P270Moskit_pylon_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\Large\LXN_P270Moskit_pylon_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Large\LXN_P270Moskit_pylon_BS3.mwm"/>
			</BuildProgressModels>
			<BlockPairName>LXN_P270Moskit_pylon</BlockPairName>
			<!-- <Center x="0" y="0" z="0" /> -->
			<BuildTimeSeconds>15</BuildTimeSeconds>
			<EdgeType>Light</EdgeType>
			<WeaponDefinitionId Subtype="LXN_Moskit" />
			<ResourceSinkGroup>Defense</ResourceSinkGroup>
			<InventoryMaxVolume>0.135</InventoryMaxVolume>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>425</PCU>
			<TargetingGroups>
				<string>Weapons</string>
			</TargetingGroups>
			<UseModelIntersection>true</UseModelIntersection>
			<MountPoints>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="4.00" EndY="2.00"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="4.00" EndY="2.00"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="1.00" EndY="4.00"/>
			</MountPoints>
			<MirroringZ>Y</MirroringZ>
			<MirroringY>Z</MirroringY>
		</Definition>
	</CubeBlocks>
</Definitions>