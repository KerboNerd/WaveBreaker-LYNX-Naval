<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>LXN_KAB1500SE_pylon</SubtypeId>
			</Id>
			<DisplayName>KAB-1500S-E Guided Bomb</DisplayName>
			<Description>The KAB-1500S-E is a precision-guided bomb that is part of the KAB-1500 family of bombs. It is designed for the Russian Aerospace Forces to carry out precision attacks using 24-channel GLONASS and is equivalent to the United States Air Force (USAF) Joint Direct Attack Munition (JDAM) family of Global Positioning System (GPS) guided weapons.</Description>
			<Icon>Textures\Icons\Cubes\LXN_KAB1500SE_pylon.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="3"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Small\LXN_KAB1500SE_pylon.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="9" />
				<Component Subtype="Computer" Count="3" />
				<Component Subtype="Construction" Count="4" />
				<Component Subtype="SmallTube" Count="4" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" />
			<BuildProgressModels>
			</BuildProgressModels>
			<BlockPairName>LXN_KAB1500SE_pylon</BlockPairName>
			<Center x="0" y="0" z="0" />
			<BuildTimeSeconds>15</BuildTimeSeconds>
			<EdgeType>Light</EdgeType>
			<WeaponDefinitionId Subtype="LXN_KAB1500SEMount" />
			<ResourceSinkGroup>Defense</ResourceSinkGroup>
			<InventoryMaxVolume>0.135</InventoryMaxVolume>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>425</PCU>
			<TargetingGroups>
				<string>Weapons</string>
			</TargetingGroups>
			<UseModelIntersection>true</UseModelIntersection>
			<MountPoints>
				<MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="1.00" EndY="3.00"/>
			</MountPoints>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
		</Definition>
	</CubeBlocks>
</Definitions>