<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>LXN_KH31AD_pylon</SubtypeId>
			</Id>
			<DisplayName>Kh-31AD Air-To-Surface Missile</DisplayName>
			<Description>The Kh-31AD, also known as Krypton, is a supersonic anti-ship missile designed for engaging high-value naval targets.
				Integration with modern targeting systems allows for precise strikes over extended distances.
				Maximum engagement range of 15,000m with a minimum operational range of 3,000m.
			</Description>
			<Icon>Textures\Icons\LXN_KH31AD_pylon.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="6"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Small\LXN_KH31AD_pylon.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="5" />
				<Component Subtype="MetalGrid" Count="2" />
				<Component Subtype="LargeTube" Count="3" />
				<Component Subtype="Motor" Count="2" />
				<Component Subtype="Computer" Count="4" />
				<Component Subtype="Construction" Count="5" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" />
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Small\LXN_KH31AD_pylon_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\Small\LXN_KH31AD_pylon_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Small\LXN_KH31AD_pylon_BS3.mwm"/>
			</BuildProgressModels>
			<BlockPairName>LXN_KH31AD_pylon</BlockPairName>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
			<Center x="0" y="0" z="0" />
			<BuildTimeSeconds>15</BuildTimeSeconds>
			<EdgeType>Light</EdgeType>
			<WeaponDefinitionId Subtype="LXN_KH31ADMount" />
			<ResourceSinkGroup>Defense</ResourceSinkGroup>
			<InventoryMaxVolume>0.135</InventoryMaxVolume>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>425</PCU>
			<TargetingGroups>
				<string>Weapons</string>
			</TargetingGroups>
			<UseModelIntersection>true</UseModelIntersection>
			<MountPoints>
				<MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="1.00" EndY="6.00" Default="true"/>
			</MountPoints>
		</Definition>
	</CubeBlocks>
</Definitions>