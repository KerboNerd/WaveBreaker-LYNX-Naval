<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>LXN_AIM120_01_pylon</SubtypeId>
			</Id>
			<DisplayName>AIM-120-D Mount</DisplayName>
			<Description>The AIM-120 Advanced Medium-Range Air-to-Air Missile (AMRAAM) is an American beyond-visual-range air-to-air missile capable of all-weather day-and-night operations.
			Requires AESA Radar (WC) to designate targets. Ranges: 12km(2km minimum)</Description>
			<Icon>Textures\Icons\LXN_AIM120_01_pylon.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="3"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Small\LXN_AIM120_01_pylon.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="5" />
				<Component Subtype="Computer" Count="3" />
				<Component Subtype="Motor" Count="2" />
				<Component Subtype="Construction" Count="3" />
				<Component Subtype="SteelPlate" Count="2" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" />
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Small\LXN_AIM120_01_pylon_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\Small\LXN_AIM120_01_pylon_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Small\LXN_AIM120_01_pylon_BS3.mwm"/>
			</BuildProgressModels>
			<BlockPairName>LXN_AIM120_01_pylon</BlockPairName>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
			<Center x="0" y="0" z="0" />
			<BuildTimeSeconds>15</BuildTimeSeconds>
			<EdgeType>Light</EdgeType>
			<WeaponDefinitionId Subtype="LXN_AIM120Mount" />
			<ResourceSinkGroup>Defense</ResourceSinkGroup>
			<InventoryMaxVolume>0.135</InventoryMaxVolume>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>425</PCU>
			<TargetingGroups>
				<string>Weapons</string>
			</TargetingGroups>
			<UseModelIntersection>true</UseModelIntersection>
			<MountPoints>
				<MountPoint Side="Top" StartX="0.02" StartY="0.02" EndX="0.98" EndY="2.98"/>
			</MountPoints>
		</Definition>
	</CubeBlocks>
</Definitions>