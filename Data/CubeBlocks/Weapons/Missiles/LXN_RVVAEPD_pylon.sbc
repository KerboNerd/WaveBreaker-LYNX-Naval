<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>LXN_RVVAEPD_pylon</SubtypeId>
			</Id>
			<DisplayName>R-VV-AE-PD LRAAM</DisplayName>
			<Description>The R-VV-AE-PD is an extended-range variant of the R-77 missile, designed for beyond visual range engagements. With active radar homing and an improved motor, it offers extended range and is capable of engaging various airborne targets at long distances, making it effective for area denial and high-value target interception.
				Requires AESA Radar (WC) to designate targets.
				15,000m max range, 3,000m minimum range.
			</Description>
			<Icon>Textures\Icons\LXN_RVVAEPD_pylon.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="3"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Small\LXN_RVVAEPD_pylon.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="9" />
				<Component Subtype="Construction" Count="1" />
				<Component Subtype="LXN_RVVAEPDMagComp" Count="1" />
			</Components>
			<CriticalComponent Subtype="SteelPlate" Index="0" />
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Small\LXN_RVVAEPD_pylon_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\Small\LXN_RVVAEPD_pylon_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Small\LXN_RVVAEPD_pylon_BS3.mwm"/>
			</BuildProgressModels>
			<BlockPairName>LXN_RVVAEPD_pylon</BlockPairName>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
			<Center x="0" y="0" z="0" />
			<BuildTimeSeconds>15</BuildTimeSeconds>
			<EdgeType>Light</EdgeType>
			<WeaponDefinitionId Subtype="LXN_RVVAEPDMount" />
			<ResourceSinkGroup>Defense</ResourceSinkGroup>
			<InventoryMaxVolume>0.135</InventoryMaxVolume>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>425</PCU>
			<TargetingGroups>
				<string>Weapons</string>
			</TargetingGroups>
			<UseModelIntersection>true</UseModelIntersection>
			<MountPoints>
				<MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="1.00" EndY="3.00"/>
			</MountPoints>
		</Definition>
	</CubeBlocks>
</Definitions>