<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>LXN_AGM84_pylon</SubtypeId>
			</Id>
			<DisplayName>AGM-84H-1 SLAM-ER</DisplayName>
			<Description>The AGM-84H SLAM-ER is an advanced, long-range cruise missile designed for precision strikes against land and sea targets. With its stand-off launch capability and terminal guidance system, it allows for engaging high-value targets from a distance, minimizing risk to the launching aircraft.
				Requires AESA Radar (WC) to designate targets
				15,000m max range, 3,000m minimum range.
			</Description>
			<Icon>Textures\Icons\LXN_AGM84_pylon.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="3"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Small\LXN_AGM84_pylon.mwm</Model>

			<Components>
				<Component Subtype="SteelPlate" Count="4" />
				<Component Subtype="Computer" Count="4" />
				<Component Subtype="Construction" Count="5" />
				<Component Subtype="Motor" Count="4" />
				<Component Subtype="SteelPlate" Count="6" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" />

			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Small\LXN_AGM84_pylon_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\Small\LXN_AGM84_pylon_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Small\LXN_AGM84_pylon_BS3.mwm"/>
			</BuildProgressModels>
			<BlockPairName>LXN_AGM84_pylon</BlockPairName>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
			<Center x="0" y="0" z="0" />
			<BuildTimeSeconds>15</BuildTimeSeconds>
			<EdgeType>Light</EdgeType>
			<WeaponDefinitionId Subtype="LXN_AGM84Mount" />
			<ResourceSinkGroup>Defense</ResourceSinkGroup>
			<InventoryMaxVolume>0.135</InventoryMaxVolume>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>425</PCU>
			<TargetingGroups>
				<string>Weapons</string>
			</TargetingGroups>
			<UseModelIntersection>true</UseModelIntersection>
			<MountPoints>
				<MountPoint Side="Top" StartX="0.00" StartY="0.00" EndX="1.00" EndY="3.00"/>
			</MountPoints>
		</Definition>
	</CubeBlocks>
</Definitions>