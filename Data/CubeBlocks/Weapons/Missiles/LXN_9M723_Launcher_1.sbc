				<Component Subtype="Construction" Count="5" />
				<Component Subtype="Motor" Count="4" />
				<Component Subtype="SteelPlate" Count="5" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" />
			<BuildProgressModels>
				<Model BuildPercentUpperBound="1.00" File="Models\9M723_Iskander\LXN_9M723_Launcher_1_BS1.mwm"/>
			</BuildProgressModels>
			<BlockPairName>LXN_9M723_Launcher_1</BlockPairName>
