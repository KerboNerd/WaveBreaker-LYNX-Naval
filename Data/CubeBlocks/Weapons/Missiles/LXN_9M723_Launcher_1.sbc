			<Size x="1" y="1" z="7"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\9M723_Iskander\LXN_9M723_Launcher_1.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="6" />
