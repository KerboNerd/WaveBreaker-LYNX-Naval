<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>LXN_AK130M_1</SubtypeId>
			</Id>
			<DisplayName>AK-130M NAVAL GUN</DisplayName>
			<Description>
				The AK-130M is a modernized single-barrel 130mm naval gun system based on the proven Soviet AK-130 design.
				This advanced artillery platform combines the devastating firepower of large-caliber naval guns with contemporary
				fire control systems and automated loading mechanisms. Designed for long-range engagement of surface targets,
				coastal installations, and naval vessels, the AK-130M delivers exceptional accuracy and destructive capability.
				The system features enhanced targeting computers and stabilization for improved performance in rough seas.
				Max engagement range: 6500m
				Rate of Fire: 45 rounds/minute
				Ammo: 130mm HE Ammo box
			</Description>
			<Icon>Textures\Icons\AK130M\Cubes\LXN_AK130M_1.dds</Icon>
			<CubeSize>Large</CubeSize>
			<PlaceDecals>false</PlaceDecals>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\AK130M\LXN_AK130M_1.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="240" />
				<Component Subtype="Construction" Count="16" />
				<Component Subtype="MetalGrid" Count="10" />
				<Component Subtype="SmallTube" Count="8" />
				<Component Subtype="Computer" Count="3" />
				<Component Subtype="Motor" Count="8" />
				<Component Subtype="SteelPlate" Count="10" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" />
			<MountPoints>
