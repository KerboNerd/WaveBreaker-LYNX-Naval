<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>LXN_STRELAM_1</SubtypeId>
			</Id>
			<DisplayName>STRELA-M CIWS</DisplayName>
			<Description>
				The STRELA-M is a Russian close-in weapon system (CIWS) inspired by the American RAM design, adapted for use on modern warships.
				Utilizing a rapid-fire missile launcher, the STRELA-M provides last-ditch defense against incoming anti-ship missiles, aircraft, and fast attack craft.
				The system features advanced radar and infrared tracking, high-speed target engagement, and automated fire control for maximum effectiveness.
				Designed for reliability and ease of integration, the STRELA-M ensures robust protection for naval vessels in high-threat environments.
				Max engagement range: 5000m
				Ammo: 57E6 Missile
			</Description>
			<Icon>Textures\Icons\STRELAM\Cubes\LXN_STRELAM_1.dds</Icon>
			<CubeSize>Large</CubeSize>
			<PlaceDecals>false</PlaceDecals>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\STRELAM\LXN_STRELAM_1.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="10" />
				<Component Subtype="Motor" Count="8" />
				<Component Subtype="Computer" Count="3" />
				<Component Subtype="SmallTube" Count="8" />
				<Component Subtype="MetalGrid" Count="10" />
				<Component Subtype="Construction" Count="16" />
				<Component Subtype="SteelPlate" Count="240" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" />
			<MountPoints>
