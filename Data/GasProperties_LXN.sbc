  <GasProperties>

    <!-- COMMON LIQUIDS =============================================================================== -->

    <!-- >>>>>> WATER <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<< -->
    <Gas>
      <Id>
        <TypeId>MyObjectBuilder_GasProperties</TypeId>
        <SubtypeId>GARG_LiquidWater</SubtypeId>
      </Id>
      <EnergyDensity>0.0001</EnergyDensity>
      <!-- MWh/litres -->
    </Gas>

    <!-- >>>>>> LIQUID HYDROGEN <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<< -->
