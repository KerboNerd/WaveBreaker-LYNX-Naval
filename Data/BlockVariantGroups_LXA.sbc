			</Blocks>
		</BlockVariantGroup>

		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="LXN_AerialRefueling_Group"/>
			<Icon>Textures\Icons\LXA_RefuelingProbe_01.dds</Icon>
			<DisplayName>Aerial Refueling</DisplayName>
			<Description>Aerial refueling, also known as in-flight refueling or air-to-air refueling, is a complex process that allows one aircraft (the tanker) to transfer fuel to another aircraft (the receiver) while both are flying.</Description>
			<Blocks>

				<Block Type="MyObjectBuilder_ShipConnectorDefinition" Subtype="LXA_RefuelingProbe_01"/>
				<Block Type="MyObjectBuilder_Conveyor" Subtype="LXA_RefuelingProbe_02"/>
				<Block Type="MyObjectBuilder_ShipConnectorDefinition" Subtype="LXA_RefuelingProbe_03"/>
				<Block Type="MyObjectBuilder_LandingGearDefinition" Subtype="LXA_RefuelingProbe_04"/>
				<Block Type="MyObjectBuilder_ShipConnectorDefinition" Subtype="LXA_RefuelingProbe_05"/>
				<Block Type="MyObjectBuilder_ShipConnectorDefinition" Subtype="LXA_RefuelingProbe_06"/>
				<Block Type="MyObjectBuilder_ShipConnectorDefinition" Subtype="LXA_RefuelingProbe_07"/>

			</Blocks>
		</BlockVariantGroup>

		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="LXN_AerialRefuelingBoom_Group"/>
			<Icon>Textures\Icons\LXN_RefuelingBoom_01_connector.dds</Icon>
			<DisplayName>Aerial Refueling Boom</DisplayName>
			<Description>Aerial refueling, also known as in-flight refueling or air-to-air refueling, is a complex process that allows one aircraft (the tanker) to transfer fuel to another aircraft (the receiver) while both are flying.</Description>
			<Blocks>

				<Block Type="MyObjectBuilder_ExtendedPistonBaseDefinition" Subtype="LXN_RefuelingBoom_01"/>
				<Block Type="MyObjectBuilder_PistonTop" Subtype="LXN_RefuelingBoom_01_end"/>
				<Block Type="MyObjectBuilder_ShipConnectorDefinition" Subtype="LXN_RefuelingBoom_01_connector"/>

			</Blocks>
		</BlockVariantGroup>

