		</BlockVariantGroup>

		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="LXN_SmallConveyor_Group"/>
			<Icon>Textures\Icons\LXN_SmallConveyor_Straight.dds</Icon>
			<DisplayName>Small Conveyors</DisplayName>
			<Description>Convey the conveyable. Is that even a word? Who knows.</Description>
			<Blocks>

				<Block Type="MyObjectBuilder_Conveyor" Subtype="LXN_SmallConveyor_Straight"/>
