  <BlockVariantGroups>

		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="LXN_JetFuelTank_Group"/>
			<Icon>Textures\Icons\LXN_JetFuelTank_1x1.dds</Icon>
			<DisplayName>Jet-Fuel Tanks</DisplayName>
			<Description>Tanks to put the stuff fueling jet engines in.</Description>
