    <!-- bofor -->
        <Sound>
      <Id>
        <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
        <SubtypeId>TT_40mmBofor</SubtypeId>
      </Id>
      <Volume>2.5</Volume>
      <Category>SHOT</Category>
      <MaxDistance>400</MaxDistance>


      <PreventSynchronization>0</PreventSynchronization>
      <SoundLimit>10</SoundLimit>
      <DistantSounds>
        <DistantSound DistanceCrossfade="10" Distance="400" Sound="TT_40mmBofor_Dist" />
      </DistantSounds>
	  <Loopable>false</Loopable>
      <Waves>
