<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_AirVentDefinition">
			<Id>
				<TypeId>AirVent</TypeId>
				<SubtypeId>Bomber_Intake</SubtypeId>
			</Id>
			<DisplayName>Bomber Intake</DisplayName>
			<Description>
			>Input Rate: 900 L/s
			>Power Consumption Idle: 150 kW
			>Power Consumption Operational: 900 kW
			Extremely powerful jet intake. Used mainly in strategic aviation.
			</Description>
			<Icon>Textures\GUI\Icons\Cubes\Bomber_Intake.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="2"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\small\Bomber_Intake.mwm</Model>
			<Components>
				<Component Subtype="InteriorPlate" Count="4"/>
				<Component Subtype="Construction" Count="10"/>
				<Component Subtype="MetalGrid" Count="4"/>
				<Component Subtype="LargeTube" Count="1"/>
				<Component Subtype="Motor" Count="7"/>
				<Component Subtype="Construction" Count="8"/>
				<Component Subtype="InteriorPlate" Count="10"/>
			</Components>
			<CriticalComponent Subtype="Motor" Index="0"/>
			<BlockPairName>Bomber_Intake</BlockPairName>
			<MirroringZ>Y</MirroringZ>
			<MirroringY>Z</MirroringY>
			<EdgeType>Light</EdgeType>
			<BuildTimeSeconds>12</BuildTimeSeconds>
			<ResourceSourceGroup>Battery</ResourceSourceGroup>
			<ResourceSinkGroup>Factory</ResourceSinkGroup>
			<OperationalPowerConsumption>0.9</OperationalPowerConsumption>
			<StandbyPowerConsumption>0.15</StandbyPowerConsumption>
			<VentilationCapacityPerSecond>900.5</VentilationCapacityPerSecond>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<PressurizeSound>BlockAirVentExhale</PressurizeSound>
			<DepressurizeSound>BlockAirVentDepressurize</DepressurizeSound>
			<IdleSound>BlockAirVentIdle</IdleSound>
			<EmissiveColorPreset>Extended</EmissiveColorPreset>
			<DestroyEffect>BlockDestroyedExplosion_Tiny</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
		</Definition>
	</CubeBlocks>
</Definitions>