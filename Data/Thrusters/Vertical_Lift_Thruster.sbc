<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ThrustDefinition">
			<Id>
				<TypeId>Thrust</TypeId>
				<SubtypeId>Vertical_Lift_Thruster</SubtypeId>
			</Id>
			<DisplayName>Vertical Lift Thruster</DisplayName>
			<Description>
			>Thrust: 15 Tonnes
			>Oxygen Consumption Idle: 100L/s
			>Oxygen Consumption Operational: 450L/s
			Special thruster, designed to provide lift in Vertical Takeoff And Landing (VTOL) configuration.
			</Description>
			<Icon>Textures\GUI\Icons\Cubes\Vertical_Lift_Thruster.dds</Icon>
			<CubeSize>Small</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="3" y="3" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\small\Vertical_Lift_Thruster.mwm</Model>
			<Components>
				<Component Subtype="InteriorPlate" Count="6"/>
				<Component Subtype="Construction" Count="15"/>
				<Component Subtype="MetalGrid" Count="5"/>
				<Component Subtype="Motor" Count="5"/>
				<Component Subtype="LargeTube" Count="2"/>
				<Component Subtype="Construction" Count="15"/>
				<Component Subtype="InteriorPlate" Count="5"/>
			</Components>
			<CriticalComponent Subtype="Motor" Index="0"/>
			<BlockPairName>Vertical_Lift_Thruster</BlockPairName>
			<ThrusterType>Hydrogen</ThrusterType>
			<UseModelIntersection>true</UseModelIntersection>
			<EdgeType>Light</EdgeType>
			<BuildTimeSeconds>15</BuildTimeSeconds>
			<ResourceSinkGroup>Thrust</ResourceSinkGroup>
			<ForceMagnitude>148500</ForceMagnitude>
			<FuelConverter>
				<FuelId>
					<TypeId>GasProperties</TypeId>
					<SubtypeId>Oxygen</SubtypeId>
				</FuelId>
				<Efficiency>1</Efficiency>
			</FuelConverter>
			<MaxPowerConsumption>0.45</MaxPowerConsumption>
			<MinPowerConsumption>0.1</MinPowerConsumption>
			<SlowdownFactor>1</SlowdownFactor>
			<MinPlanetaryInfluence>0.1</MinPlanetaryInfluence>
			<MaxPlanetaryInfluence>1</MaxPlanetaryInfluence>
			<EffectivenessAtMinInfluence>1</EffectivenessAtMinInfluence>
			<EffectivenessAtMaxInfluence>0.95</EffectivenessAtMaxInfluence>
			<NeedsAtmosphereForInfluence>true</NeedsAtmosphereForInfluence>
			<FlameDamageLengthScale>0</FlameDamageLengthScale>
			<FlameLengthScale>0</FlameLengthScale>
			<FlameIdleColor>
				<X>0</X>
				<Y>0</Y>
				<Z>0</Z>
				<W>0</W>
			</FlameIdleColor>
			<FlameFullColor>
				<X>0</X>
				<Y>0</Y>
				<Z>0</Z>
				<W>0</W>
			</FlameFullColor>
			<FlamePointMaterial>EngineThrustMiddle</FlamePointMaterial>
			<FlameLengthMaterial>EngineThrustMiddle</FlameLengthMaterial>
			<FlameFlare>LargeGridSmallThruster</FlameFlare>
			<FlameVisibilityDistance>0</FlameVisibilityDistance>
			<FlameGlareQuerySize>1</FlameGlareQuerySize>
			<PrimarySound></PrimarySound>
			<DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
			<DamagedSound>ParticleWeapExpl</DamagedSound>
			<Public>true</Public>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>15</PCU>
			<IsAirTight>false</IsAirTight>
			<TieredUpdateTimes>
				<unsignedInt>100</unsignedInt>
				<unsignedInt>3600</unsignedInt>
				<unsignedInt>0</unsignedInt>
			</TieredUpdateTimes>
			<TargetingGroups>
				<string>Propulsion</string>
			</TargetingGroups>
			<BlockVariants>
				<BlockVariant>
					<TypeId>Thrust</TypeId>
					<SubtypeId>Vertical_Lift_Thruster</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>Thrust</TypeId>
					<SubtypeId>Vertical_Lift_Stabalizer_Thruster_15</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>Thrust</TypeId>
					<SubtypeId>Vertical_Lift_Stabalizer_Thruster_30</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>AirVent</TypeId>
					<SubtypeId>Vertical_Lift_Fan</SubtypeId>
				</BlockVariant>
				<BlockVariant>
					<TypeId>AirVent</TypeId>
					<SubtypeId>Vertical_Lift_Fan_NoVFX</SubtypeId>
				</BlockVariant>
			</BlockVariants>
		</Definition>
		
		
