    <BlueprintClasses>

        <!-- >>>>>> OIL DISTILLATION <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<< -->
        <Class>
            <Id>
                <TypeId>BlueprintClassDefinition</TypeId>
                <SubtypeId>GARG_OilDistillation</SubtypeId>
            </Id>
            <DisplayName>Oil Distillation</DisplayName>
            <Description>
                Distill the darn oil, filthy American!
            </Description>
            <Icon>Textures\Icons\Components\LXN_Component_Drum_01.dds</Icon>
            <HighlightIcon>Textures\Icons\Components\LXN_Component_Drum_01.dds</HighlightIcon>
            <FocusIcon>Textures\Icons\Components\LXN_Component_Drum_01.dds</FocusIcon>
            <InputConstraintIcon>Textures\Icons\Components\LXN_Component_Drum_01.dds</InputConstraintIcon>
        </Class>
        <!-- >>>>>> OIL DISTILLATION <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<< -->
        <Class>
            <Id>
                <TypeId>BlueprintClassDefinition</TypeId>
                <SubtypeId>GARG_OilHydrotreatment</SubtypeId>
            </Id>
            <DisplayName>Oil Hydrotreatment</DisplayName>
            <Description>
                Hydrotreatment is a process that uses hydrogen and catalysts under high pressure to
                remove impurities from hydrocarbon feedstocks, improving their quality for further
                refining or cleaner-burning fuel applications.
            </Description>
            <Icon>Textures\Icons\Components\LXN_Component_Drum_01.dds</Icon>
            <HighlightIcon>Textures\Icons\Components\LXN_Component_Drum_01.dds</HighlightIcon>
            <FocusIcon>Textures\Icons\Components\LXN_Component_Drum_01.dds</FocusIcon>
            <InputConstraintIcon>Textures\Icons\Components\LXN_Component_Drum_01.dds</InputConstraintIcon>
        </Class>

    </BlueprintClasses>


