<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <Ammos>
        <Ammo xsi:type="MyObjectBuilder_MissileAmmoDefinition">
            <Id>
                <TypeId>AmmoDefinition</TypeId>
                <SubtypeId>LXN_AIM120Ammo</SubtypeId>
            </Id>
            <BasicProperties>
                <DesiredSpeed>900</DesiredSpeed>
                <SpeedVariance>0</SpeedVariance>
                <MaxTrajectory>7000</MaxTrajectory>
                <IsExplosive>false</IsExplosive>
                <BackkickForce>0</BackkickForce>
                <PhysicalMaterial>Aim9Mat</PhysicalMaterial>
            </BasicProperties>
            <MissileProperties>
                <MissileMass>86</MissileMass>
                <MissileExplosionRadius>9</MissileExplosionRadius>
                <MissileModelName>Models\Small\LXN_AIM120_01_missile.mwm</MissileModelName>
                <MissileAcceleration>50</MissileAcceleration>
                <MissileInitialSpeed>150</MissileInitialSpeed>
                <MissileSkipAcceleration>false</MissileSkipAcceleration>
				<MissileExplosionDamage>1500</MissileExplosionDamage>
                <MissileTrailEffect>Smoke_Missile_AIM9</MissileTrailEffect>
				<MissileGravityEnabled>true</MissileGravityEnabled>
            </MissileProperties>
        </Ammo>
        <Ammo xsi:type="MyObjectBuilder_ProjectileAmmoDefinition">
            <Id>
                <TypeId>AmmoDefinition</TypeId>
                <SubtypeId>LXN_Energy</SubtypeId>
            </Id>
            <BasicProperties>
                <DesiredSpeed>0.0002</DesiredSpeed>
                <SpeedVariance>0</SpeedVariance>
                <MaxTrajectory>0.0001</MaxTrajectory>
                <BackkickForce>0</BackkickForce>
            </BasicProperties>
            <ProjectileProperties>
                <ProjectileHitImpulse>0</ProjectileHitImpulse>
                <ProjectileMassDamage>0</ProjectileMassDamage>
                <ProjectileHealthDamage>0</ProjectileHealthDamage>
                <ProjectileMaterial>GunBullet</ProjectileMaterial>
                <ProjectileTrailScale>0</ProjectileTrailScale>
                <ProjectileTrailProbability>0</ProjectileTrailProbability>
            </ProjectileProperties>
        </Ammo>
    </Ammos>

	<AmmoMagazines>
		<AmmoMagazine>
            <Id>
                <TypeId>AmmoMagazine</TypeId>
                <SubtypeId>LXN_AIM120Mag</SubtypeId>
            </Id>
            <DisplayName>AIM-120 Missile</DisplayName>
            <Icon>Textures\Icons\LXN_AIM120_01_pylon.dds</Icon>
            <Size>
                <X>0.24</X>
                <Y>0.2</Y>
                <Z>0.2</Z>
            </Size>
            <Mass>152</Mass>
            <Volume>90</Volume>
            <Model>Models\Small\LXN_AIM120_01_missile.mwm</Model>
            <PhysicalMaterial>Ammo</PhysicalMaterial>
            <Capacity>1</Capacity>
            <AmmoDefinitionId Subtype="LXN_AIM120Ammo" />

            <MinimumOfferAmount>50</MinimumOfferAmount>
            <MaximumOfferAmount>500</MaximumOfferAmount>
            <MinimumOrderAmount>100</MinimumOrderAmount>
            <MaximumOrderAmount>2000</MaximumOrderAmount>
            <CanPlayerOrder>true</CanPlayerOrder>
        </AmmoMagazine>
        <AmmoMagazine>
            <Id>
                <TypeId>AmmoMagazine</TypeId>
                <SubtypeId>LXN_Blank</SubtypeId>
            </Id>
            <DisplayName>Blank</DisplayName>
            <Icon>Textures\GUI\Icons\component\BatteryComponent.dds</Icon>
            <Size>
                <X>0.25</X>
                <Y>0.2</Y>
                <Z>0.2</Z>
            </Size>
            <Mass>1</Mass>
            <Volume>1</Volume>
            <Model>Models\Components\PowerCellComponent.mwm</Model>
            <Capacity>1</Capacity>
            <AmmoDefinitionId Subtype="LXN_Energy" />
        </AmmoMagazine>
	</AmmoMagazines>
	<Blueprints>
		<Blueprint>
            <Id>
                <TypeId>BlueprintDefinition</TypeId>
                <SubtypeId>LXN_AIM120_BP</SubtypeId>
            </Id>
            <DisplayName>AIM-120 Missile</DisplayName>
            <Icon>Textures\Icons\LXN_AIM120_01_pylon.dds</Icon>
            <Prerequisites>
                <Item Amount="20" TypeId="Ingot" SubtypeId="Iron" />
                <Item Amount="10" TypeId="Ingot" SubtypeId="Nickel" />
                <Item Amount="5" TypeId="Ingot" SubtypeId="Silicon" />
                <Item Amount="3" TypeId="Ingot" SubtypeId="Magnesium" />
                <Item Amount="2" TypeId="Ingot" SubtypeId="Cobalt" />
                <!-- <Item Amount="1" TypeId="Component" SubtypeId="Nato_GuidanceSystem" /> -->
                <!-- <Item Amount="1" TypeId="Component" SubtypeId="Nato_Warhead" /> -->
            </Prerequisites>
            <Result Amount="1" TypeId="AmmoMagazine" SubtypeId="LXN_AIM120Mag" />
            <BaseProductionTimeInSeconds>3</BaseProductionTimeInSeconds>
        </Blueprint>
	</Blueprints>

    <BlueprintClassEntries>
        <Entry Class="EliteConsumables" BlueprintSubtypeId="LXN_AIM120_CompBP" />
        <Entry Class="EliteConsumables" BlueprintSubtypeId="LXN_AIM120_BP" />
    </BlueprintClassEntries>

	<Weapons>
		<Weapon>
            <Id>
                <TypeId>WeaponDefinition</TypeId>
                <SubtypeId>LXN_AIM120Mount</SubtypeId>
            </Id>
            <MissileAmmoData RateOfFire="5" ShootSoundName="AIM54Shot" FlightSoundName="CAP_Missile_Fly_Loop" ShotsInBurst="1" />
            <DeviateShotAngle>0.1</DeviateShotAngle>
            <DeviateShotAngleAiming>0.1</DeviateShotAngleAiming>
            <NoAmmoSoundName>WepShipGatlingNoAmmo</NoAmmoSoundName>
            <AmmoMagazines>
                <AmmoMagazine Subtype="LXN_AIM120Mag" />
            </AmmoMagazines>
            <ReloadTime>8000</ReloadTime>
        </Weapon>
	</Weapons>
	
	<CategoryClasses>
			<Category xsi:type="MyObjectBuilder_GuiBlockCategoryDefinition">
				<Id>
					<TypeId>GuiBlockCategoryDefinition</TypeId>
					<SubtypeId/>
				</Id>
					<DisplayName>DisplayName_Category_ShipWeapons</DisplayName>
					<Name>ShipWeapons</Name>
					<SearchBlocks>false</SearchBlocks>
					<IsShipCategory>true</IsShipCategory>
					<IsBlockCategory>false</IsBlockCategory>
					<IsToolCategory>true</IsToolCategory>
					<ItemIds>
						<string>LXN_AIM120Mount</string>
					</ItemIds>	
			</Category>

	</CategoryClasses>
</Definitions>
