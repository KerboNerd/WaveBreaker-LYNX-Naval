                <Item Amount="250" TypeId="Ingot" SubtypeId="Iron" />
                <Item Amount="60" TypeId="Ingot" SubtypeId="Nickel" />
                <Item Amount="50" TypeId="Ingot" SubtypeId="Silicon" />
                <Item Amount="30" TypeId="Ingot" SubtypeId="Magnesium" />
				<Item Amount="30" TypeId="Ingot" SubtypeId="Uranium" />
				<Item Amount="15" TypeId="Ingot" SubtypeId="Platinum" />
				<Item Amount="2" TypeId="Component" SubtypeId="LXN_EnrichedUranium_01" />
				
            </Prerequisites>
            <Result Amount="1" TypeId="AmmoMagazine" SubtypeId="LXN_9M723Mag" />
            <BaseProductionTimeInSeconds>6000</BaseProductionTimeInSeconds>
        </Blueprint>
	</Blueprints>

    <BlueprintClassEntries>
