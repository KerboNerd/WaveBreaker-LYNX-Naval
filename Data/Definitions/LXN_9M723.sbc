<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <Ammos>
        <Ammo xsi:type="MyObjectBuilder_MissileAmmoDefinition">
            <Id>
                <TypeId>AmmoDefinition</TypeId>
                <SubtypeId>LXN_9M723Ammo</SubtypeId>
            </Id>
            <BasicProperties>
                <DesiredSpeed>900</DesiredSpeed>
                <SpeedVariance>0</SpeedVariance>
                <MaxTrajectory>7000</MaxTrajectory>
                <IsExplosive>false</IsExplosive>
                <BackkickForce>0</BackkickForce>
                <PhysicalMaterial>Aim9Mat</PhysicalMaterial>
            </BasicProperties>
            <MissileProperties>
                <MissileMass>3750</MissileMass>
                <MissileExplosionRadius>9</MissileExplosionRadius>
                <MissileModelName>Models\9M723_Iskander\LXN_9M723_Missile_2.mwm</MissileModelName>
                <MissileAcceleration>50</MissileAcceleration>
                <MissileInitialSpeed>150</MissileInitialSpeed>
                <MissileSkipAcceleration>false</MissileSkipAcceleration>
				<MissileExplosionDamage>1500</MissileExplosionDamage>
                <MissileTrailEffect>Smoke_Missile_AIM9</MissileTrailEffect>
				<MissileGravityEnabled>true</MissileGravityEnabled>
            </MissileProperties>
        </Ammo>
    </Ammos>

	<AmmoMagazines>
		<AmmoMagazine>
            <Id>
                <TypeId>AmmoMagazine</TypeId>
                <SubtypeId>LXN_9M723Mag</SubtypeId>
            </Id>
            <DisplayName>9M723 "Iskander" Ballistic Missile</DisplayName>
