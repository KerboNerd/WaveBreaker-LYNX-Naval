            <Size>
                <X>7.3</X>
                <Y>0.92</Y>
                <Z>0.92</Z>
            </Size>
            <Mass>3750</Mass>
            <Volume>3800</Volume>
            <Model>Models\9M723_Iskander\LXN_9M723_Missile_2.mwm</Model>
            <PhysicalMaterial>Ammo</PhysicalMaterial>
            <Capacity>1</Capacity>
            <AmmoDefinitionId Subtype="LXN_9M723Ammo" />

            <MinimumOfferAmount>50</MinimumOfferAmount>
            <MaximumOfferAmount>500</MaximumOfferAmount>
            <MinimumOrderAmount>100</MinimumOrderAmount>
            <MaximumOrderAmount>2000</MaximumOrderAmount>
            <CanPlayerOrder>true</CanPlayerOrder>
        </AmmoMagazine>
	</AmmoMagazines>

	<Blueprints>
		<Blueprint>
            <Id>
                <TypeId>BlueprintDefinition</TypeId>
                <SubtypeId>LXN_9M723_BP</SubtypeId>
            </Id>
            <DisplayName>9M723 "Iskander" Ballistic Missile</DisplayName>
