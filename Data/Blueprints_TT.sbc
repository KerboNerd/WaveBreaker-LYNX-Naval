    <Blueprint>
        <Id>
          <TypeId>BlueprintDefinition</TypeId>
          <SubtypeId>TTMK15Torpedo</SubtypeId>
        </Id>
        <DisplayName>Mark 15 torpedo</DisplayName>
        <Icon>Textures\GUI\Icons\Ammo\TTMK15Torpedo.dds</Icon>
        <Prerequisites>
          <Item Amount="30" TypeId="Ingot" SubtypeId="Iron" />
          <Item Amount="15" TypeId="Ingot" SubtypeId="Nickel" />
          <Item Amount="15" TypeId="Ingot" SubtypeId="Magnesium" />
          <Item Amount="10" TypeId="Ingot" SubtypeId="Silicon" />
          <Item Amount="2" TypeId="Ingot" SubtypeId="Silver" />
          <Item Amount="1" TypeId="Ingot" SubtypeId="Cobalt" />
        </Prerequisites>
        <Result Amount="1" TypeId="AmmoMagazine" SubtypeId="TTMK15Torpedo" />
        <BaseProductionTimeInSeconds>20</BaseProductionTimeInSeconds>
      </Blueprint>

