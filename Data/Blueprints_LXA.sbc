  <Blueprints>

    <!-- Metal Drum -->
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>LXN_MetalDrum_Recipe</SubtypeId>
      </Id>
      <DisplayName>Metal Drum</DisplayName>
      <Icon>Textures\Icons\Components\LXN_Component_Drum_01.dds</Icon>
      <Prerequisites>
        <Item Amount="10" TypeId="Component" SubtypeId="SteelPlate" />
        <Item Amount="5" TypeId="Component" SubtypeId="Construction" />
      </Prerequisites>
      <Result Amount="1" TypeId="Component" SubtypeId="LXN_MetalDrum_Component" />
      <BaseProductionTimeInSeconds>1</BaseProductionTimeInSeconds>
    </Blueprint>



