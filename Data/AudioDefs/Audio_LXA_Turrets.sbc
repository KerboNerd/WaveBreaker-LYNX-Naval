<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">

    <Sounds>

        <!-- ================= GROZA CIWS ======================================= -->
        <Sound>
            <Id>
                <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
                <SubtypeId>LXN_CIWS30_DistanceFire</SubtypeId>
            </Id>
            <Category>SHOT</Category>
            <MaxDistance>3000</MaxDistance>
            <PreventSynchronization>15</PreventSynchronization>
            <PitchVariation>50</PitchVariation>
            <Loopable>true</Loopable>
            <Volume>1.0</Volume>
            <Waves>
                <Wave Type="D3">
                    <Start>Audio\CIWS\LXN_CIWS30_DistanceFire.wav</Start>
                </Wave>
            </Waves>
        </Sound>


        <Sound>
            <Id>
                <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
                <SubtypeId>LXN_CIWS30_Audio</SubtypeId>
            </Id>
            <Category>SHOT</Category>
            <MaxDistance>300</MaxDistance>
            <PreventSynchronization>15</PreventSynchronization>
            <PitchVariation>50</PitchVariation>
            <Loopable>true</Loopable>
            <DistantSounds>
                <DistantSound DistanceCrossfade="200" Distance="300" Sound="LXN_CIWS30_DistanceFire" />
            </DistantSounds>
            <Volume>1.0</Volume>
            <Waves>
                <Wave Type="D3">
                    <Start>Audio\CIWS\LXN_CIWS30_Fire.wav</Start>
                </Wave>
            </Waves>
        </Sound>

        <Sound>
            <Id>
                <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
                <SubtypeId>LXN_CIWS30_Spinup</SubtypeId>
            </Id>
            <Category>SHOT</Category>
            <MaxDistance>300</MaxDistance>
            <PreventSynchronization>15</PreventSynchronization>
            <PitchVariation>50</PitchVariation>
            <Loopable>false</Loopable>
            <Volume>1.0</Volume>
            <Waves>
                <Wave Type="D3">
                    <Start>Audio\CIWS\LXN_CIWS30_Spinup.wav</Start>
                </Wave>
            </Waves>
        </Sound>

        <Sound>
            <Id>
                <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
                <SubtypeId>LXN_CIWS30_Spindown</SubtypeId>
            </Id>
            <Category>SHOT</Category>
            <MaxDistance>300</MaxDistance>
            <PreventSynchronization>15</PreventSynchronization>
            <PitchVariation>50</PitchVariation>
            <Loopable>false</Loopable>
            <Volume>1.0</Volume>
            <Waves>
                <Wave Type="D3">
                    <Start>Audio\CIWS\LXN_CIWS30_Spindown.wav</Start>
                </Wave>
            </Waves>
        </Sound>

    </Sounds>

</Definitions>