<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema">

	<Sounds>

		<!-- ================= S-400 ======================================= -->

		<Sound>
			<Id>
				<TypeId>MyObjectBuilder_AudioDefinition</TypeId>
				<SubtypeId>LXN_S400_Travel</SubtypeId>
			</Id>
			<Category>SHIP</Category>
			<MaxDistance>5000</MaxDistance>
			<PitchVariation>200</PitchVariation>
			<RealisticFilter>realShipFilter</RealisticFilter>
			<!-- <PreventSynchronization>15</PreventSynchronization> -->
			<Volume>1</Volume>
			<Loopable>true</Loopable>
			<Waves>
				<Wave Type="D3">
					<Loop>Audio\Missiles\S400\Arc_S400_Travel_01.wav</Loop>
				</Wave>
			</Waves>
		</Sound>

        <Sound>
            <Id>
                <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
                <SubtypeId>LXN_S400_Explosion</SubtypeId>
            </Id>
            <Category>SHOT</Category>
            <MaxDistance>2000</MaxDistance>
            <PreventSynchronization>0</PreventSynchronization>
            <!-- <DynamicMusicCategory>HeavyFight</DynamicMusicCategory>
            <DynamicMusicAmount>3</DynamicMusicAmount> -->
            <!-- <DistantSounds>
                <DistantSound DistanceCrossfade="10" Distance="200" Sound="WepShipGatlingShotDistant1" />
            </DistantSounds> -->
            <Volume>1</Volume>
            <Waves>
                <Wave Type="D3">
                    <Start>Audio\Missiles\S400\Arc_S400_Explosion_01.wav</Start>
                </Wave>
				<Wave Type="D3">
                    <Start>Audio\Missiles\S400\Arc_S400_Explosion_02.wav</Start>
                </Wave>
            </Waves>
        </Sound>

		<Sound>
            <Id>
                <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
                <SubtypeId>LXN_S400_Fire</SubtypeId>
            </Id>
            <Category>SHOT</Category>
            <MaxDistance>100</MaxDistance>
            <PreventSynchronization>0</PreventSynchronization>
            <!-- <DynamicMusicCategory>HeavyFight</DynamicMusicCategory>
            <DynamicMusicAmount>3</DynamicMusicAmount> -->
            <!-- <DistantSounds>
                <DistantSound DistanceCrossfade="10" Distance="200" Sound="WepShipGatlingShotDistant1" />
            </DistantSounds> -->
            <Volume>2</Volume>
            <Waves>
                <!-- <Wave Type="D3">
                    <Start>Audio\Missiles\S400\Arc_S400_Fire_01.wav</Start>
                </Wave> -->
				<Wave Type="D3">
                    <Start>Audio\Missiles\S400\Arc_S400_Fire_02.wav</Start>
                </Wave>
            </Waves>
        </Sound>

		<Sound>
            <Id>
                <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
                <SubtypeId>LXN_S400_Launch</SubtypeId>
            </Id>
            <Category>SHOT</Category>
            <MaxDistance>100</MaxDistance>
            <PreventSynchronization>0</PreventSynchronization>
            <!-- <DynamicMusicCategory>HeavyFight</DynamicMusicCategory>
            <DynamicMusicAmount>3</DynamicMusicAmount> -->
            <!-- <DistantSounds>
                <DistantSound DistanceCrossfade="10" Distance="200" Sound="WepShipGatlingShotDistant1" />
            </DistantSounds> -->
            <Volume>1.5</Volume>
            <Waves>
                <Wave Type="D3">
                    <Start>Audio\Missiles\S400\Arc_S400_Launch_01.wav</Start>
                </Wave>
				<Wave Type="D3">
                    <Start>Audio\Missiles\S400\Arc_S400_Launch_02.wav</Start>
                </Wave>
				<Wave Type="D3">
                    <Start>Audio\Missiles\S400\Arc_S400_Launch_03.wav</Start>
                </Wave>
            </Waves>
        </Sound>


