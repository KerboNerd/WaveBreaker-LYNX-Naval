<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema">

	<Sounds>

		<Sound>
			<Id>
				<TypeId>MyObjectBuilder_AudioDefinition</TypeId>
				<SubtypeId>LXAOJetEngine</SubtypeId>
			</Id>
			<Category>BLOCK</Category>
			<MaxDistance>150</MaxDistance>
			<Volume>0.5</Volume>
			<Loopable>true</Loopable>
			<UpdateDistance>120</UpdateDistance>
			<Waves>
				<Wave Type="D3">
					<Start>Audio\Jets\LXA_GENX_Startup.wav</Start>
					<Loop>Audio\Jets\LXA_GENX_Running.wav</Loop>
					<End>Audio\Jets\LXA_GENX_Shutdown.wav</End>
				</Wave>
			</Waves>
		</Sound>

		<Sound>
			<Id>
				<TypeId>MyObjectBuilder_AudioDefinition</TypeId>
				<SubtypeId>LXAJetThruster</SubtypeId>
			</Id>
			<Category>SHIP_JET</Category>
			<MaxDistance>450</MaxDistance>
			<!--PitchVariation>100</PitchVariation>-->
			<RealisticFilter>realShipFilter</RealisticFilter>
			<DistantSounds>
				<DistantSound DistanceCrossfade="25" Distance="450" Sound="LXAJetThrusterNear" />
				<DistantSound DistanceCrossfade="25" Distance="1500" Sound="LXAJetThrusterFar" />
				<DistantSound DistanceCrossfade="25" Distance="3500" Sound="LXAJetThrusterEmpty" />
			</DistantSounds>
			<PreventSynchronization>15</PreventSynchronization>
			<Volume>0.25</Volume>
			<Loopable>true</Loopable>
			<Waves>
				<Wave Type="D3">
					<Loop>Audio\Jets\LXA_GENX_Running.wav</Loop>
				</Wave>
			</Waves>
		</Sound>

		<Sound>
			<Id>
				<TypeId>MyObjectBuilder_AudioDefinition</TypeId>
				<SubtypeId>LXAJetThrusterNear</SubtypeId>
			</Id>
			<Category>SHIP_JET</Category>
			<MaxDistance>1500</MaxDistance>
			<PitchVariation>50</PitchVariation>
			<RealisticFilter>realShipFilter</RealisticFilter>
			<PreventSynchronization>15</PreventSynchronization>
			<Volume>0.125</Volume>
			<Loopable>true</Loopable>
			<Waves>
				<Wave Type="D3">
					<Loop>Audio\Jets\LXA_GENX_Running.wav</Loop>
				</Wave>
			</Waves>
		</Sound>

		<Sound>
			<Id>
				<TypeId>MyObjectBuilder_AudioDefinition</TypeId>
				<SubtypeId>LXAJetThrusterFar</SubtypeId>
			</Id>
			<Category>SHIP_JET</Category>
			<MaxDistance>3500</MaxDistance>
			<PitchVariation>50</PitchVariation>
			<RealisticFilter>realShipFilter</RealisticFilter>
			<PreventSynchronization>15</PreventSynchronization>
			<Volume>1</Volume>
			<Loopable>true</Loopable>
			<Waves>
				<Wave Type="D3">
					<Loop>Audio\Jets\LXA_GENX_Far.wav</Loop>
				</Wave>
			</Waves>
		</Sound>

		<!--"Empty"
		sound fixes constant sounds stuck looping at long range-->

		<Sound>
