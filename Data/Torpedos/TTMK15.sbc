<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>TTMK15</SubtypeId>
			</Id>
			<DisplayName>Mark 15 Quintuple Torpedo Tubes</DisplayName>
			<Description>The Mark 15 torpedo was the 
			standard American destroyer-launched torpedo of World War II.
		
			Max engagement range: TBA
			Rate of Fire: TBA
			Reload Time: TBA
			Ammo: TT Mark 15 torpedo
			</Description>
			<Icon>Textures\GUI\Icons\TTMK15.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="3" y="3" z="3"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\large\TTMK15.mwm</Model>
			<Components>
             <Component Subtype="SteelPlate" Count="1500" />
             <Component Subtype="Construction" Count="190" />
             <Component Subtype="MetalGrid" Count="30" />
			 <Component Subtype="SmallTube" Count="25" /> 
             <Component Subtype="LargeTube" Count="30" />
             <Component Subtype="Motor" Count="20" />			 
             <Component Subtype="Computer" Count="20" />
             <Component Subtype="MetalGrid" Count="50" />			 
             <Component Subtype="SteelPlate" Count="1500" />
            </Components>
            <CriticalComponent Subtype="Computer" Index="0" />
			<BlockPairName>TTMK15</BlockPairName>
			<MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="3.00" EndY="2.00"/>
				<MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="3.00" EndY="2.00"/>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="3.00" EndY="2.00"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="3.00" EndY="2.00"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00"/>
			</MountPoints>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
			<DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
			<DamagedSound>ParticleElectrical</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<EmissiveColorPreset>Default</EmissiveColorPreset>
						<RequiredPowerInput>0.00002</RequiredPowerInput>
											<PCU>150</PCU>
		</Definition>
		<Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
			<Id>
				<TypeId>ConveyorSorter</TypeId>
				<SubtypeId>TTMK15Triple</SubtypeId>
			</Id>
			<DisplayName>Mark 15 Triple Torpedo Tubes</DisplayName>
			<Description>The Mark 15 torpedo was the 
			standard American destroyer-launched torpedo of World War II.
		
			Max engagement range: TBA
			Rate of Fire: TBA
			Reload Time: TBA
			Ammo: TT Mark 15 torpedo
			</Description>
			<Icon>Textures\GUI\Icons\TTMK15Triple.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="3" z="3"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\large\TTMK15Triple.mwm</Model>
			<Components>
             <Component Subtype="SteelPlate" Count="1500" />
             <Component Subtype="Construction" Count="190" />
             <Component Subtype="MetalGrid" Count="30" />
			 <Component Subtype="SmallTube" Count="25" /> 
             <Component Subtype="LargeTube" Count="30" />
             <Component Subtype="Motor" Count="20" />			 
             <Component Subtype="Computer" Count="20" />
             <Component Subtype="MetalGrid" Count="50" />			 
             <Component Subtype="SteelPlate" Count="1500" />
            </Components>
            <CriticalComponent Subtype="Computer" Index="0" />
			<MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="1.00" EndY="2.00"/>
				<MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="1.00" EndY="2.00"/>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="3.00" EndY="2.00"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.00" EndX="3.00" EndY="2.00"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="1.00" EndY="3.00"/>
			</MountPoints>
			<BlockPairName>TTMK15Triple</BlockPairName>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
			<DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
			<DamagedSound>ParticleElectrical</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<EmissiveColorPreset>Default</EmissiveColorPreset>
						<RequiredPowerInput>0.00002</RequiredPowerInput>
											<PCU>150</PCU>
		</Definition>
	</CubeBlocks>
</Definitions>
